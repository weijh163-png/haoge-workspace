  {code:'CF0501',name:'餐饮六分部办公室',contact:'李长静',dept:'餐饮六分部',costAcc:'陈晨',isProxy:false,type:'职能部门',bizType:'职能',notes:'日常无收入核算',unresolved:'',settlement:''}
];

function renderProjects(filter){
  const tbody = document.getElementById('projTbody');
  if(!tbody) return;
  tbody.innerHTML = '';
  PROJECTS.forEach(p => {
    if(filter && filter !== 'all'){
      if(filter === '第三方' && !p.notes.includes('第三方') && !p.settlement.includes('第三方')) return;
      if(filter === '未了' && !p.unresolved) return;
      if(filter === '代管' && !p.isProxy) return;
      if(['职能部门','一分部','二分部','三分部','五分部','六分部'].includes(filter) && !p.dept.includes(filter)) return;
      if(['差额结算','人员服务','全额结算'].includes(filter) && !p.type.includes(filter)) return;
    }
    const hasUnresolved = p.unresolved && p.unresolved.length > 0;
    const tr = document.createElement('tr');
    tr.style.borderBottom = '1px solid var(--border)';
    tr.style.background = hasUnresolved ? 'var(--amber-l)' : (p.isProxy ? 'var(--blue-l)' : '');
    const typeBadge = p.bizType === '差额' ? 'badge-amber' : p.bizType === '人员服务' ? 'badge-blue' : p.bizType === '全额+人员' ? 'badge-blue' : p.bizType === '职能' ? 'badge-gray' : 'badge-green';
    const proxyBadge = p.isProxy ? '<span class="badge badge-blue" style="font-size:10px;margin-left:3px">代</span>' : '';
    tr.innerHTML = '<td style="padding:6px 8px;font-weight:600;white-space:nowrap">' + p.code + proxyBadge + '</td>'
      + '<td style="padding:6px 8px;white-space:nowrap">' + p.name + '</td>'
      + '<td style="padding:6px 8px;white-space:nowrap;font-size:11px;color:var(--muted)">' + (p.dept || '-') + '</td>'
      + '<td style="padding:6px 8px;white-space:nowrap;font-size:11px">' + p.contact + '</td>'
      + '<td style="padding:6px 8px;white-space:nowrap;font-size:11px;color:var(--muted)">' + (p.costAcc || '-') + '</td>'
      + '<td style="padding:6px 8px;white-space:nowrap">' + (p.type ? '<span class="badge ' + typeBadge + '">' + p.type + '</span>' : '-') + '</td>'
      + '<td style="padding:6px 8px;font-size:11px;max-width:260px">' + (p.notes || '-') + '</td>'
      + '<td style="padding:6px 8px;font-size:11px;color:' + (hasUnresolved ? 'var(--red)' : 'var(--muted)') + ';max-width:220px">' + (p.unresolved || '-') + '</td>';
    tbody.appendChild(tr);
  });
  if(tbody.children.length === 0){
    tbody.innerHTML = '<tr><td colspan="8" style="padding:16px;text-align:center;color:var(--muted)">无匹配项目</td></tr>';
  }
}

function filterProjects(filter){ renderProjects(filter); }

