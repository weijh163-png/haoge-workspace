<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>浩哥工作台 · 收入核算科 v2 · archify整合</title>
<style>
:root{
  --pri:#2563eb;--pri-l:#dbeafe;--pri-d:#1d4ed8;
  --teal:#0d9488;--teal-l:#ccfbf1;
  --amber:#f59e0b;--amber-l:#fef3c7;
  --red:#ef4444;--red-l:#fee2e2;
  --green:#22c55e;--green-l:#dcfce7;
  --slate:#64748b;--slate-l:#f1f5f9;
  --bg:#f0f4f8;--card:#fff;--border:#e2e8f0;
  --text:#1e293b;--muted:#64748b;
  --radius:12px;--shadow:0 1px 3px rgba(0,0,0,.08),0 1px 2px rgba(0,0,0,.04);
  --shadow-md:0 4px 6px rgba(0,0,0,.07),0 2px 4px rgba(0,0,0,.04);
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft YaHei",sans-serif;background:var(--bg);color:var(--text);font-size:13px;line-height:1.5}
.nav-bar{background:linear-gradient(135deg,#1e3a5f,#2563eb);color:#fff;padding:0 20px;height:48px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;box-shadow:0 2px 8px rgba(0,0,0,.15)}
.nav-brand{font-size:16px;font-weight:700;display:flex;align-items:center;gap:6px}
.nav-brand span{font-size:11px;font-weight:400;opacity:.8;padding:1px 6px;background:rgba(255,255,255,.15);border-radius:8px}
.nav-tabs{display:flex;gap:2px}
.nav-tab{padding:6px 14px;border-radius:6px;cursor:pointer;transition:.2s;font-size:13px;opacity:.8}
.nav-tab:hover{opacity:1;background:rgba(255,255,255,.1)}
.nav-tab.active{background:rgba(255,255,255,.2);opacity:1;font-weight:600}
.nav-date{font-size:11px;opacity:.7}
.container{max-width:1320px;margin:0 auto;padding:12px 16px}
.module{display:none}
.module.active{display:block}
.card{background:var(--card);border-radius:10px;box-shadow:var(--shadow);padding:14px;margin-bottom:10px}
.card-title{font-size:15px;font-weight:600;margin-bottom:10px;display:flex;align-items:center;gap:6px}
.card-title .ico{font-size:16px}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.hero{background:linear-gradient(135deg,#2563eb,#0d9488);color:#fff;border-radius:10px;padding:16px 20px;margin-bottom:12px;display:flex;justify-content:space-between;align-items:center}
.hero h1{font-size:20px;margin-bottom:2px}
.hero p{font-size:12px;opacity:.85}
.hero-stats{display:flex;gap:16px}
.hero-stat .num{font-size:24px;font-weight:700}
.hero-stat .lbl{font-size:10px;opacity:.8}
.alert-box{border-radius:8px;padding:10px 12px;margin-bottom:10px;display:flex;align-items:flex-start;gap:8px;font-size:12px}
.alert-box .alert-ico{font-size:18px;flex-shrink:0}
.day-task{display:flex;align-items:flex-start;gap:8px;padding:8px 10px;border-radius:6px;background:var(--slate-l);margin-bottom:4px;transition:.2s}
.day-task .dt-check{width:16px;height:16px;cursor:pointer;accent-color:var(--pri);margin-top:2px;flex-shrink:0}
.day-task .dt-text{flex:1;font-size:12px}
.day-task .dt-time{font-size:10px;color:var(--pri);font-weight:600;background:var(--pri-l);padding:1px 5px;border-radius:3px;white-space:nowrap}
.day-task .dt-pri{font-size:9px;padding:1px 4px;border-radius:3px;font-weight:600}
.progress-ring{width:90px;height:90px;position:relative;margin:0 auto}
.progress-ring .pct{font-size:18px;font-weight:700}
.progress-ring .txt{font-size:9px;color:var(--muted)}
.btn{padding:6px 12px;border-radius:6px;border:none;cursor:pointer;font-size:12px;font-weight:600;transition:.2s}
.btn-sm{padding:3px 8px;font-size:11px;border-radius:4px}
.divider{height:1px;background:var(--border);margin:10px 0}
.section-hint{font-size:11px;color:var(--muted);margin-bottom:8px}
.stat-mini{background:var(--card);border-radius:10px;box-shadow:var(--shadow);padding:10px 12px;text-align:center;transition:.2s}
.stat-mini:hover{box-shadow:var(--shadow-md)}
.stat-bar-bg{background:var(--slate-l);border-radius:3px;height:4px;margin:4px 0;overflow:hidden}
.stat-bar{background:var(--pri);height:100%;border-radius:3px;transition:width .5s ease}
.done-panel{border-left:3px solid var(--green);border-radius:0 8px 8px 0;background:var(--green-l);margin-top:6px;padding:6px 10px}
.done-item{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--green);margin-bottom:2px}
.done-item::before{content:'✓';font-weight:700}
.tag-row{display:flex;gap:4px;flex-wrap:wrap}
.calc-box{background:var(--slate-l);border-radius:8px;padding:14px}
.calc-row{display:grid;grid-template-columns:2fr 1fr 1fr 1fr 1fr 1fr;gap:6px;margin-bottom:4px;align-items:center}
.calc-row label{font-size:12px;color:var(--muted)}
.calc-row input{padding:5px 8px;border:1px solid var(--border);border-radius:6px;font-size:12px;outline:none;width:100%}
.calc-row input:focus{border-color:var(--pri)}
.calc-row .calc-val{background:var(--amber-l);padding:3px 8px;border-radius:4px;font-size:12px;font-weight:600;color:#92400e;text-align:center}
.gen-output{background:#1e293b;color:#e2e8f0;border-radius:8px;padding:14px;font-family:"Consolas","Microsoft YaHei",monospace;font-size:12px;line-height:1.8;max-height:350px;overflow-y:auto;white-space:pre-wrap;word-break:break-all}
.gen-output .proj-line{padding:2px 0;border-bottom:1px solid rgba(255,255,255,.05)}
/* ==================== Flowchart Module (archify integration) ==================== */
.fc-toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:12px}
.fc-btn{padding:6px 14px;border-radius:8px;border:1px solid var(--border);background:var(--card);cursor:pointer;font-size:12px;font-weight:600;transition:.2s;color:var(--text)}
.fc-btn:hover{border-color:var(--pri);color:var(--pri)}
.fc-btn.active{background:var(--pri);color:#fff;border-color:var(--pri)}
.fc-theme-toggle{display:inline-flex;align-items:center;gap:4px}
.fc-svg-wrap{background:#f8fafc;border-radius:10px;border:1px solid var(--border);overflow:hidden;position:relative;min-height:420px}
.fc-svg-wrap.dark{background:#1e293b}
.fc-svg-wrap svg{display:block;cursor:grab}
.fc-svg-wrap svg:active{cursor:grabbing}
.fc-node{cursor:pointer;transition:opacity .2s}
.fc-node:hover .fc-node-box{stroke-width:2.5}
.fc-node.dim{opacity:.25}
.fc-edge{fill:none;stroke-width:1.8;transition:opacity .2s}
.fc-edge.dim{opacity:.15}
.fc-edge.highlight{stroke-width:3}
.fc-edge-label{font-size:10px;fill:var(--muted);pointer-events:none}
.fc-lane-label{font-size:12px;font-weight:700;fill:var(--text)}
.fc-phase-label{font-size:11px;font-weight:600;fill:var(--pri-d)}
.fc-node-box{fill:#fff;stroke:var(--border);stroke-width:1.5;rx:8}
.fc-node-title{font-size:12px;font-weight:600;fill:var(--text);pointer-events:none}
.fc-node-sub{font-size:10px;fill:var(--muted);pointer-events:none}
.fc-node-tag{font-size:9px;font-weight:600}
.fc-info-panel{background:var(--card);border-radius:10px;border:1px solid var(--border);padding:14px;margin-top:12px;min-height:60px}
.fc-info-panel .fc-info-title{font-size:14px;font-weight:700;margin-bottom:6px;color:var(--pri-d)}
.fc-info-panel .fc-info-body{font-size:12px;color:var(--text);line-height:1.7}
.fc-info-panel .fc-info-tag{display:inline-block;font-size:10px;padding:2px 8px;border-radius:4px;font-weight:600;margin-left:6px}
.fc-review-box{background:var(--slate-l);border-radius:10px;padding:16px;margin-top:14px}
.fc-review-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
@media(max-width:768px){.fc-review-grid{grid-template-columns:1fr}}
.fc-review-item{border:1px solid var(--border);border-radius:8px;padding:10px}
.fc-review-item h5{font-size:12px;font-weight:700;margin-bottom:6px;display:flex;align-items:center;gap:4px}
.fc-review-item textarea{width:100%;border:1px solid var(--border);border-radius:6px;padding:6px 8px;font-size:12px;resize:vertical;min-height:60px;font-family:inherit;outline:none}
.fc-review-item textarea:focus{border-color:var(--pri)}
.fc-month-select{padding:5px 10px;border:1px solid var(--border);border-radius:6px;font-size:12px;outline:none}
.fc-month-select:focus{border-color:var(--pri)}
.fc-stat-badge{display:inline-block;font-size:11px;padding:3px 8px;border-radius:4px;font-weight:600}
.fc-legend{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;font-size:11px}
.fc-legend-item{display:flex;align-items:center;gap:4px}
.fc-legend-dot{width:10px;height:10px;border-radius:2px;flex-shrink:0}
.fc-card-box{border:1px solid var(--border);border-radius:8px;padding:10px;margin-top:8px}
.fc-card-box h5{font-size:12px;font-weight:700;margin-bottom:4px}
.fc-card-box li{font-size:11px;color:var(--muted);line-height:1.6}
/* Animated flow + pulse effects */
.fc-flow-anim .fc-edge{stroke-dasharray:12 8;animation:fcDashSlide 1.2s linear infinite}
.fc-flow-anim .fc-edge.highlight{stroke-dasharray:none;animation:none;stroke-width:3}
.fc-flow-anim .fc-edge.dim{animation:none}
.fc-flow-paused .fc-edge{stroke-dasharray:none;animation:none}
.fc-edge-glow{fill:none;pointer-events:none}
@keyframes fcDashSlide{from{stroke-dashoffset:0}to{stroke-dashoffset:-20}}
.fc-node{transition:opacity .3s,transform .3s}
.fc-node:hover{transform:translateY(-1px)}
.fc-node:hover .fc-node-box{filter:drop-shadow(0 3px 6px rgba(0,0,0,.15))}
.fc-node.glow{opacity:1 !important}
.fc-node.glow .fc-node-box{stroke-width:3;filter:drop-shadow(0 0 10px rgba(37,99,235,.5))}
.fc-node.glow .fc-node-title{font-weight:700;fill:var(--pri-d)}
.fc-story-active .fc-node:not(.glow){opacity:.2}
.fc-story-active .fc-edge:not(.highlight){opacity:.15}
.fc-story-active .fc-node.glow{opacity:1;z-index:10}
.fc-node.dim{opacity:.2;transition:opacity .3s}
.fc-flow-particle{fill:var(--pri);opacity:0;pointer-events:none}
.fc-glow .fc-node-box{animation:fcBoxGlow 2s ease-in-out infinite}
@keyframes fcBoxGlow{0%{filter:drop-shadow(0 0 2px rgba(37,99,235,.3))}50%{filter:drop-shadow(0 0 8px rgba(37,99,235,.6))}100%{filter:drop-shadow(0 0 2px rgba(37,99,235,.3))}}
.fc-play-btn{display:inline-flex;align-items:center;gap:4px;padding:6px 14px;border-radius:8px;border:1px solid var(--pri);background:var(--pri);color:#fff;cursor:pointer;font-size:12px;font-weight:700;transition:.2s}
.fc-play-btn:hover{background:var(--pri-d)}
.fc-play-btn.active{background:var(--red);border-color:var(--red)}
.fc-play-btn.active:hover{background:var(--red-d)}

/* ===== Prototype D Dashboard Styles ===== */
.dash-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.dash-head h1{font-size:18px}
.dash-head .sub{font-size:12px;color:var(--muted);margin-top:2px}
.ring-row{display:flex;justify-content:space-between;align-items:center;gap:12px;background:linear-gradient(135deg,#1e3a5f,#2563eb);border-radius:14px;padding:16px 22px;color:#fff;margin-bottom:14px}
.ring-row .greet{flex:1}
.ring-row .greet h2{font-size:17px;margin:0}
.ring-row .greet p{font-size:12px;opacity:.8;margin-top:3px;margin-bottom:0}
.kpi{display:flex;gap:18px}
.kpi .kv{text-align:center}
.kpi .kv .vn{font-size:22px;font-weight:700}
.kpi .kv .vl{font-size:10.5px;opacity:.75}
.card-h{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.card-h .t{font-size:14px;font-weight:600;display:flex;align-items:center;gap:6px}
.card-h .t .bar{width:3px;height:14px;border-radius:2px;background:var(--pri)}
.badge{font-size:11px;font-weight:600;padding:2px 9px;border-radius:99px}
.b-b{background:var(--pri-l);color:var(--pri)}
.b-g{background:var(--green-l);color:var(--green)}
.todo-item{display:flex;align-items:center;gap:9px;padding:9px 8px;border-radius:8px;cursor:pointer;transition:.15s}
.todo-item:hover{background:var(--slate-l)}
.todo-item input{width:16px;height:16px;accent-color:var(--pri);cursor:pointer;flex-shrink:0}
.todo-item .nm{flex:1;font-size:12.5px}
.todo-item .tm{font-size:10.5px;color:var(--muted);flex-shrink:0}
.todo-item .tag{font-size:10px;font-weight:600;padding:1px 6px;border-radius:4px;flex-shrink:0}
.tag-p{background:var(--red-l);color:var(--red)}
.tag-m{background:var(--amber-l);color:var(--amber)}
.todo-item.done .nm{text-decoration:line-through;color:var(--muted)}
.done-toggle{margin-top:6px;font-size:12px;color:var(--green);cursor:pointer;padding:8px;border-radius:8px;text-align:center;background:var(--green-l);user-select:none}
.done-list{display:none;margin-top:5px}
.done-list.open{display:block}
.done-list .todo-item .nm{color:var(--muted);text-decoration:line-through}
.prog-ring{display:flex;align-items:center;gap:14px}
.ring{--v:100;width:64px;height:64px;border-radius:50%;background:conic-gradient(var(--green) calc(var(--v)*1%),var(--slate-l) 0);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.ring>div{width:48px;height:48px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:var(--text)}
.ring.tax{--v:100;background:conic-gradient(var(--teal) calc(var(--v)*1%),var(--slate-l) 0)}
.alert{display:flex;gap:8px;padding:9px 10px;border-radius:9px;font-size:11.5px;margin-bottom:7px}
.alert:last-child{margin-bottom:0}
.alert .ic{flex-shrink:0}
.alert.a{background:var(--amber-l)}
.alert.r{background:var(--red-l)}
.alert.t{background:var(--teal-l)}
.report-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.rp{display:flex;align-items:center;gap:6px;font-size:11.5px;padding:8px;border:1px solid var(--border);border-radius:8px}
.rp .ok{margin-left:auto;color:var(--green);font-weight:700;font-size:15px}
.rp .dept{font-size:9.5px;color:var(--muted);display:block}
@media(max-width:900px){.grid-2{grid-template-columns:1fr}.report-grid{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>

<nav class="nav-bar">
  <div class="nav-brand">浩哥工作台 <span>收入核算科 v2</span></div>
  <div class="nav-tabs">
    <div class="nav-tab active" onclick="switchTab('dashboard')">首页 · 今日</div>
    <div class="nav-tab" onclick="switchTab('workflow')">月度工作流程</div>
    <div class="nav-tab" onclick="switchTab('assistant')">AI辅助系统</div>
    <div class="nav-tab" onclick="switchTab('reports')">报表自动化</div>
    <div class="nav-tab" onclick="switchTab('projects')">项目台账</div>
    <div class="nav-tab" onclick="switchTab('flowchart')">流程图与复盘</div>
    <div class="nav-tab" onclick="switchTab('extra')">扎口与未了</div>
  </div>
  <div class="nav-date" id="navDate"></div>
</nav>

<div class="container">

<!-- ==================== Module 1: Dashboard ==================== -->
<section class="module active" id="dashboard">

  <!-- 顶部问候 -->
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;padding:0 4px">
    <div>
      <div style="font-size:16px;font-weight:700">浩哥，早上好 👋</div>
      <div style="font-size:11px;color:var(--muted);margin-top:2px" id="dateLine">2026年09月11日 周五 · 距结账 15 天 · 距税务师考试 64 天</div>
    </div>
    <div style="display:flex;gap:10px;align-items:center">
      <div style="text-align:center"><div style="font-size:18px;font-weight:700;color:var(--pri)" id="taskCountHero">0</div><div style="font-size:10px;color:var(--muted)">待办</div></div>
      <div style="text-align:center"><div style="font-size:18px;font-weight:700;color:var(--green)" id="reportHero">0/7</div><div style="font-size:10px;color:var(--muted)">报表</div></div>
    </div>
  </div>

  <div class="grid-2">
    <!-- 左：今日待办 -->
    <div class="card" style="border-left:4px solid var(--pri)">
      <div class="card-h"><div class="t"><span class="bar"></span>今日待办</div><div class="badge b-b" id="todoCnt">0 项</div></div>
      <div id="todayTasks"></div>
      <div class="done-toggle" onclick="toggleDonePanel()">✓ 已完成（<span id="doneCount">0</span>）— 点击展开</div>
      <div class="done-list" id="doneTasksList"></div>
    </div>
    <!-- 右：动态重点提醒 -->
    <div>
      <div class="card">
        <div class="card-h"><div class="t"><span class="bar" style="background:var(--amber)"></span>重点提醒</div></div>
        <div id="dynamicAlerts"></div>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="card" style="padding:10px 14px;margin-top:10px">
    <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
      <span style="font-size:14px">⚡</span>
      <span style="font-size:13px;font-weight:600">快捷操作</span>
    </div>
    <div style="display:flex;gap:6px;flex-wrap:wrap">
      <button class="btn btn-pri btn-sm" onclick="switchTab('workflow')">月度流程</button>
      <button class="btn btn-outline btn-sm" onclick="switchTab('assistant')">AI注意事项</button>
      <button class="btn btn-outline btn-sm" onclick="switchTab('reports')">报表中心</button>
      <button class="btn btn-outline btn-sm" onclick="switchTab('projects')">项目台账</button>
      <button class="btn btn-outline btn-sm" onclick="switchTab('flowchart')">流程图</button>
      <button class="btn btn-outline btn-sm" onclick="resetMonthlyData()">重置数据</button>
    </div>
  </div>
</section>

<!-- ==================== Module 2: Workflow ==================== -->
<section class="module" id="workflow">
  <div class="card">
    <div class="card-title"><span class="ico">📅</span> 月度工作流程</div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px">
      <span style="padding:4px 10px;background:var(--red-l);color:var(--red);border-radius:99px;font-size:11px;font-weight:600">申报期 1-10号</span>
      <span style="padding:4px 10px;background:var(--pri-l);color:var(--pri);border-radius:99px;font-size:11px;font-weight:600">常规期 11-25号</span>
      <span style="padding:4px 10px;background:var(--teal-l);color:var(--teal);border-radius:99px;font-size:11px;font-weight:600">结账期 26-30号</span>
    </div>
    <div style="font-size:12px;color:var(--muted);line-height:1.8">
      <div><strong style="color:var(--text)">1-3号</strong> · 银行回单 + 指标明细核对 + 营业额统计</div>
      <div><strong style="color:var(--text)">4-5号</strong> · 应收表 + 异常汇总 + 统计报送</div>
      <div><strong style="color:var(--text)">6-10号</strong> · 税务申报（先个税）+ 补开票催办</div>
      <div><strong style="color:var(--text)">11-25号</strong> · 日常开票制单 + 银行回单 + 回款通知</div>
      <div><strong style="color:var(--text)">26-30号</strong> · 催报 + 销项核对 + 装订凭证</div>
    </div>
    <div style="margin-top:10px;padding-top:10px;border-top:1px solid var(--border)">
      <div style="font-size:11px;color:var(--muted)">💡 完整逐日任务与注意事项请查看各专项页面</div>
    </div>
  </div>
</section>

<!-- ==================== Module 3: AI Assistant ==================== -->
<section class="module" id="assistant">
  <div class="card">
    <div class="card-title"><span class="ico">🤖</span> AI自动化辅助系统 · 操作注意事项手册</div>
    <div class="section-hint">收入核算日常操作13条核心注意事项，点击展开查看详细操作步骤。这些规则覆盖制单、开票、核对、红冲等高频场景。</div>
    <div id="noticeList"></div>
  </div>

  <!-- Tax Declaration -->
  <div class="card" id="taxSection">
    <div class="card-title"><span class="ico">🏢</span> 税务申报指引（7家公司）</div>
    <div class="section-hint">每月10号前完成 · 先申报个税再申报税务 · 完成后同步填写2张表+税金缴纳确认表</div>

    <div style="background:var(--amber-l);border-radius:8px;padding:12px;margin-bottom:14px;font-size:13px;color:#92400e">
      <strong>申报顺序提醒：</strong>先申报个税（自然人电子税务局），再申报增值税及附加（电子税务局）。
      完成后同步填写：①附件中两张表 ②管理二科发出的【腾讯文档】税金缴纳确认表。<br>
      <strong>频次差异：</strong>铜仁、福州为<strong>季报</strong>（非月报），其余为月报。个税均为月度申报。
    </div>

    <div class="tax-grid" id="taxGrid"></div>

    <div class="divider"></div>
    <div style="font-size:13px;font-weight:600;margin-bottom:8px">📋 申报步骤</div>
    <div class="tax-step"><span class="ts-num">1</span><span>先申报个税：自然人电子税务局扣缴端，6家公司逐一申报综合所得预扣预缴表</span></div>
    <div class="tax-step"><span class="ts-num">2</span><span>再申报税务：电子税务局，增值税→城建税→教育费附加→地方教育附加→其他税种</span></div>
    <div class="tax-step"><span class="ts-num">3</span><span>同步填写附件中两张表（税收数据统计表）</span></div>
    <div class="tax-step"><span class="ts-num">4</span><span>填写管理二科【腾讯文档】税金缴纳确认表</span></div>
    <div class="tax-step"><span class="ts-num">5</span><span>确认所有申报完成，标记打卡</span></div>

    <div class="divider"></div>
    <div style="font-size:12px;color:var(--muted);line-height:1.8">
      <strong>税收数据统计表结构：</strong><br>
      ・Sheet1「电子税务局」：序号/征收项目/征收品目/税款所属期/入（退）库日期/实缴金额/报税人/公司名称<br>
      ・Sheet2「自然人电子税务局-个税」：税款所属期/申报表名称/申报人次/当期收入/应补退税额/申报类型/申报渠道/申报时间/报税人/公司名称<br>
      <strong>福州分公司税金计提表模板：</strong>含公司概况表、月度申报表、税金汇总表及18个附表（增值税/城建税/教育费附加/地方教育附加/水利建设基金/印花税/土地使用税/房产税/契税/企业所得税/个税/罚款滞纳金/工会经费/残保金/车船税/车辆购置税/城镇垃圾处理费/文化事业建设费）
    </div>
  </div>

  <!-- Special Operations -->
  <div class="card">
    <div class="card-title"><span class="ico">🔧</span> 特殊操作指引</div>

    <div class="routine-card">
      <h4>🟡 红冲上月发票</h4>
      <div class="tax-step"><span class="ts-num">1</span><span>先生成对应的收款单（删掉其他金额，只保留红冲金额）</span></div>
      <div class="tax-step"><span class="ts-num">2</span><span>点删除对应的收款单金额</span></div>
      <div class="tax-step"><span class="ts-num">3</span><span>找到对应的应收单，红冲对应的收款金额</span></div>
      <div class="tax-step"><span class="ts-num">4</span><span>项目提供红冲发票申请，并重新做收款计划和应收单</span></div>
    </div>

    <div class="routine-card">
      <h4>🔵 银行收款金额与收款单不符</h4>
      <div class="tax-step"><span class="ts-num">1</span><span>收款单管理 → 未生效的单据 → 联查单据</span></div>
      <div class="tax-step"><span class="ts-num">2</span><span>查看收款计划，确认冲销金额是否与银行回单金额一致</span></div>
      <div class="tax-step"><span class="ts-num">3</span><span>如果一致，手动修改收款单管理的"组织本币金额"（贷方）与银行保持一致</span></div>
      <div class="tax-step"><span class="ts-num">4</span><span>尾款待下次进账时，自制收款单查询该金额</span></div>
    </div>

    <div class="routine-card">
      <h4>🎓 徐州医科大学开票流程</h4>
      <div class="tax-step"><span class="ts-num">1</span><span>先根据开票申请表开收据，当天寄出</span></div>
      <div class="tax-step"><span class="ts-num">2</span><span>校方结算单待收据提供后才提供，不盖章，分部负责人签字</span></div>
      <div class="tax-step"><span class="ts-num">3</span><span>先开收据，后开发票（收据开全额，发票开差额）</span></div>
      <div class="tax-step"><span class="ts-num">4</span><span>收据、开票申请和最后实际开的发票放在一起，当月开票</span></div>
    </div>

    <div class="routine-card">
      <h4>💳 卡机开票附件要求</h4>
      <div class="routine-item">卡机开票必须附有：校方盖章版本的结算单，或分部负责人签字</div>
      <div class="routine-item">缺失附件不得开票</div>
    </div>

    <div class="routine-card">
      <h4>💰 出售固定资产制单</h4>
      <div class="routine-item">制单时税金要从全额营业额中手动扣除</div>
    </div>

    <div class="routine-card">
      <h4>📋 制单顺序</h4>
      <div class="routine-item" style="font-weight:600;color:var(--pri)">先做收款计划单据，后做应收单单据</div>
    </div>
  </div>
</section>

<!-- ==================== Module 4: Reports ==================== -->
<section class="module" id="reports">

  <div class="card">
    <div class="card-title"><span class="ico">📈</span> 七份月度报表</div>
    <div class="section-hint">每月3号前提交 · 复核人：谢苗苗 · 填报单位：财务部收入核算科</div>
    <div id="reportCardsList"></div>
  </div>

  <!-- Exception Report Generator -->
  <div class="card" id="exceptionGen">
    <div class="card-title"><span class="ico">⚡</span> 异常情况说明生成器</div>
    <div class="section-hint">方式一：导入同期营业额统计表自动生成；方式二：手动录入数据生成。差额营业额 = 营业额 - 代扣款</div>

    <!-- Import Section -->
    <div class="calc-box" style="margin-bottom:12px;border:2px dashed var(--pri);background:var(--pri-l)">
      <div style="font-size:13px;font-weight:600;margin-bottom:6px;color:var(--pri-d)">📥 导入同期营业额统计分析表（.xlsx）</div>
      <div style="font-size:11px;color:var(--muted);margin-bottom:10px;line-height:1.6">
        导入后自动提取 21 个项目的当月+累计数据，按固定格式规则生成异常说明<br>
        文件要求：含「当月」和「累计」两个Sheet，A列=项目编码(CF开头)，E列=营业额，F列=代扣款，G列=差额，H列=2026年差额，I列=增减
      </div>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <input type="file" id="excelFileInput" accept=".xlsx" style="display:none" onchange="handleFileImport(event)">
        <button class="btn btn-pri" onclick="document.getElementById('excelFileInput').click()">📥 选择Excel文件</button>
        <button class="btn btn-outline" onclick="generateFromImport()" id="genFromImportBtn" disabled style="opacity:.5">⚡ 从导入数据生成</button>
        <span id="importStatus" style="font-size:12px;color:var(--muted)"></span>
      </div>
      <div id="importPreview" style="margin-top:10px;display:none"></div>
    </div>

    <div class="calc-box" style="margin-bottom:12px">
      <div style="font-size:13px;font-weight:600;margin-bottom:8px">参数设置（导入和手动通用）</div>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px">
        <div>
          <label style="font-size:11px;color:var(--muted)">报表月份（数字）</label>
          <input type="number" id="genMonth" value="8" min="1" max="12" style="padding:5px 8px;border:1px solid var(--border);border-radius:6px;width:100%">
        </div>
        <div>
          <label style="font-size:11px;color:var(--muted)">去年（年）</label>
          <input type="number" id="genLastYear" value="2025" style="padding:5px 8px;border:1px solid var(--border);border-radius:6px;width:100%">
        </div>
        <div>
          <label style="font-size:11px;color:var(--muted)">今年（年）</label>
          <input type="number" id="genThisYear" value="2026" style="padding:5px 8px;border:1px solid var(--border);border-radius:6px;width:100%">
        </div>
        <div>
          <label style="font-size:11px;color:var(--muted)">累计月份（数字）</label>
          <input type="number" id="genCumMonth" value="8" min="1" max="12" style="padding:5px 8px;border:1px solid var(--border);border-radius:6px;width:100%">
        </div>
      </div>
    </div>

    <div class="calc-box" style="margin-bottom:12px">
      <div style="font-size:13px;font-weight:600;margin-bottom:8px">项目数据录入</div>
      <div class="calc-row" style="font-size:11px;font-weight:700;color:var(--muted)">
        <div>项目</div><div>营业额(万)</div><div>代扣款(万)</div><div>差额营业额</div><div>去年差额(万)</div><div>操作</div>
      </div>
      <div id="dataRows"></div>
      <button class="btn btn-outline btn-sm" style="margin-top:8px" onclick="addDataRow()">+ 添加项目行</button>
    </div>

    <div style="display:flex;gap:8px;margin:12px 0">
      <button class="btn btn-pri" onclick="generateExceptionReport()">生成异常说明</button>
      <button class="btn btn-outline" onclick="copyGenerated()">复制全部</button>
      <button class="btn btn-outline" onclick="clearOutput()">清空输出</button>
    </div>

    <div id="genOutputArea" style="display:none">
      <div style="font-size:14px;font-weight:600;margin-bottom:8px">生成结果</div>
      <div class="gen-output" id="genOutput"></div>
    </div>
  </div>

  <!-- Pre-submission Checklist -->
  <div class="card" id="checklistSection">
    <div class="card-title"><span class="ico">🔍</span> 报表提交前检查清单</div>
    <div class="section-hint">每月提交7份报表前逐项核对</div>
    <div class="grid-2">
      <div>
        <div style="font-size:13px;font-weight:600;margin-bottom:6px;color:var(--pri)">数据准确性</div>
        <div class="checklist-item"><input type="checkbox" id="ck1"><label for="ck1">各项目营业额与报账员确认一致</label></div>
        <div class="checklist-item"><input type="checkbox" id="ck2"><label for="ck2">差额营业额 = 营业额 - 代扣款 已验证</label></div>
        <div class="checklist-item"><input type="checkbox" id="ck3"><label for="ck3">分组作业消费产值+跨期开票差额与项目报表一致</label></div>
        <div class="checklist-item"><input type="checkbox" id="ck4"><label for="ck4">累计数据 = 1月至本月逐月累加</label></div>
        <div class="checklist-item"><input type="checkbox" id="ck5"><label for="ck5">金额统一为万元，保留2位小数</label></div>
        <div class="checklist-item"><input type="checkbox" id="ck6"><label for="ck6">销项税额与开票系统税额一致</label></div>
        <div class="checklist-item"><input type="checkbox" id="ck7"><label for="ck7">总账收入与开票系统收入一致</label></div>
        <div class="checklist-item"><input type="checkbox" id="ck8"><label for="ck8">借贷方向无负数情况</label></div>
      </div>
      <div>
        <div style="font-size:13px;font-weight:600;margin-bottom:6px;color:var(--teal)">格式与完整性</div>
        <div class="checklist-item"><input type="checkbox" id="ck9"><label for="ck9">7份报表全部编制完成</label></div>
        <div class="checklist-item"><input type="checkbox" id="ck10"><label for="ck10">截止日期、会计责任人已更新</label></div>
        <div class="checklist-item"><input type="checkbox" id="ck11"><label for="ck11">5档逾期金额分类正确</label></div>
        <div class="checklist-item"><input type="checkbox" id="ck12"><label for="ck12">同期对比增减值计算正确</label></div>
        <div class="checklist-item"><input type="checkbox" id="ck13"><label for="ck13">报表签字版本已收齐（5-7号催收）</label></div>
        <div class="checklist-item"><input type="checkbox" id="ck14"><label for="ck14">经营情况异常问题分类分工汇总已定稿</label></div>
        <div class="checklist-item"><input type="checkbox" id="ck15"><label for="ck15">已提交谢苗苗复核</label></div>
        <div class="checklist-item"><input type="checkbox" id="ck16"><label for="ck16">应收账龄分析表已发项目催收</label></div>
      </div>
    </div>
    <div class="divider"></div>
    <div style="font-size:12px;color:var(--muted);line-height:1.8">
      <strong>注意：</strong>CF251苏州职大和CF450天津大学仅出现在累计表中，当月表不填。
      <strong>核对顺序：</strong>先核对销项税额，后核对收入。
      <strong>总账收入构成：</strong>主营业务收入/餐饮收入 + 商品销售收入 + 其他服务收入。
    </div>
  </div>

  <!-- Quick Calc -->
  <div class="card">
    <div class="card-title"><span class="ico">🧮</span> 快速计算工具</div>
    <div class="section-hint">输入营业额和代扣款，自动计算差额营业额和同比增减</div>
    <div class="calc-box">
      <div class="calc-row" style="font-size:11px;font-weight:700;color:var(--muted)">
        <div>项目</div><div>营业额</div><div>代扣款</div><div>差额营业额</div><div>去年差额</div><div>同比增减</div>
      </div>
      <div class="calc-row">
        <input type="text" id="calcProj" value="测试项目">
        <input type="number" id="calcRev" value="100.00" step="0.01" oninput="autoCalc()">
        <input type="number" id="calcDed" value="15.00" step="0.01" oninput="autoCalc()">
        <div class="calc-val" id="calcDiff">85.00</div>
        <input type="number" id="calcLastDiff" value="80.00" step="0.01" oninput="autoCalc()">
        <div class="calc-val" id="calcYoY" style="background:var(--green-l);color:var(--green)">+5.00</div>
      </div>
    </div>
    <div style="font-size:12px;color:var(--muted);margin-top:8px">
      差额营业额 = 营业额 - 代扣款 ｜ 同比增减 = 今年差额 - 去年差额（正数=增加，负数=减少）
    </div>
  </div>
</section>

<!-- ==================== Module 5: Project Ledger ==================== -->
<section class="module" id="projects">
  <div class="card">
    <div class="card-title"><span class="ico">📂</span> 项目台账 · 业务类型与核算要点</div>
    <div class="section-hint">根据2026年暑期培训最新项目清单整理，浩哥负责的64个项目（含24个代管）。按分部和业务类型分类，含对接人、成本科会计、结算方式和未了事项。</div>
    <div style="margin-bottom:6px;display:flex;gap:6px;flex-wrap:wrap;align-items:center">
      <span style="font-size:11px;color:var(--muted);margin-right:2px">分部:</span>
      <button class="btn btn-outline btn-sm" onclick="filterProjects('all')">全部</button>
      <button class="btn btn-outline btn-sm" onclick="filterProjects('职能部门')">职能部门</button>
      <button class="btn btn-outline btn-sm" onclick="filterProjects('一分部')">一分部</button>
      <button class="btn btn-outline btn-sm" onclick="filterProjects('二分部')">二分部</button>
      <button class="btn btn-outline btn-sm" onclick="filterProjects('三分部')">三分部</button>
      <button class="btn btn-outline btn-sm" onclick="filterProjects('五分部')">五分部</button>
      <button class="btn btn-outline btn-sm" onclick="filterProjects('六分部')">六分部</button>
    </div>
    <div style="margin-bottom:10px;display:flex;gap:6px;flex-wrap:wrap;align-items:center">
      <span style="font-size:11px;color:var(--muted);margin-right:2px">类型:</span>
      <button class="btn btn-outline btn-sm" onclick="filterProjects('差额结算')">差额结算</button>
      <button class="btn btn-outline btn-sm" onclick="filterProjects('人员服务')">人员服务</button>
      <button class="btn btn-outline btn-sm" onclick="filterProjects('全额结算')">全额结算</button>
      <button class="btn btn-outline btn-sm" onclick="filterProjects('第三方')">第三方收款</button>
      <button class="btn btn-outline btn-sm" onclick="filterProjects('未了')">未了事项</button>
      <button class="btn btn-outline btn-sm" onclick="filterProjects('代管')">仅代管</button>
    </div>
    <div style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse;font-size:12px" id="projTable">
        <thead>
          <tr style="background:var(--slate-l)">
            <th style="padding:6px 8px;text-align:left;border-bottom:2px solid var(--border);white-space:nowrap">编码</th>
            <th style="padding:6px 8px;text-align:left;border-bottom:2px solid var(--border);white-space:nowrap">项目名称</th>
            <th style="padding:6px 8px;text-align:left;border-bottom:2px solid var(--border);white-space:nowrap">分部</th>
            <th style="padding:6px 8px;text-align:left;border-bottom:2px solid var(--border);white-space:nowrap">对接人</th>
            <th style="padding:6px 8px;text-align:left;border-bottom:2px solid var(--border);white-space:nowrap">成本科</th>
            <th style="padding:6px 8px;text-align:left;border-bottom:2px solid var(--border);white-space:nowrap">业务类型</th>
            <th style="padding:6px 8px;text-align:left;border-bottom:2px solid var(--border);white-space:nowrap">核算要点</th>
            <th style="padding:6px 8px;text-align:left;border-bottom:2px solid var(--border);white-space:nowrap">未了事项</th>
          </tr>
        </thead>
        <tbody id="projTbody"></tbody>
      </table>
    </div>
  </div>

  <!-- 苏大项目特殊流程 -->
  <div class="card">
    <div class="card-title"><span class="ico">🎓</span> 苏大项目特殊流程（CF101/102/108/120/121/122/134）</div>
    <div class="routine-card">
      <h4>账期：上月26日 - 本月25日</h4>
      <div class="routine-item">对接人：后勤处汪会计、财务处龚老师、各食堂报账员/项目经理</div>
      <div class="routine-item">所需材料：①苏大食堂营业额申领单 ②汪会计发的餐券表/水电费表/材料入库表 ③各食堂出库月份餐券表 ④扶贫材料出库说明及汇总表（需盖公章）⑤营业额发票</div>
      <div class="routine-item" style="font-weight:600;color:var(--pri)">流程：先去后勤处和汪会计对账 → 学校签字确认 → 复印留档 → 交苏大财务处龚老师</div>
    </div>
  </div>

  <!-- 高新区项目特殊流程 -->
  <div class="card">
    <div class="card-title"><span class="ico">🏫</span> 高新区项目人员服务费核算（CF160/173/174/175/177/179/180）</div>
    <div class="routine-card">
      <h4>收入确认原则：孰低原则</h4>
      <div class="routine-item">按营业额的25%减低耗金额与实际人工孰低原则确认每月人员服务费收入</div>
      <div class="routine-item">服务费结算标准：学生餐费和教师餐费总额的3%</div>
      <div class="routine-item">单个校区年度服务费不超过 ¥200,000.00，费用按学年结算</div>
      <div class="routine-item" style="font-weight:600;color:var(--amber)">每月做完收入后，在科微信群填写共享表格《科桥餐饮阳光食堂项目主要经营数据统计表》</div>
    </div>
  </div>

  <!-- 代购不提管理费项目 -->
  <div class="card">
    <div class="card-title"><span class="ico">💰</span> 代购营业额不提管理费项目</div>
