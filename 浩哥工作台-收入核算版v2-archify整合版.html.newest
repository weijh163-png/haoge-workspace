            ${done ? '<span style="color:var(--green)">✓ 已完成</span>' : ''}
          </div>
        </div>
        <div style="font-size:20px;font-weight:800;color:${done?'var(--green)':'var(--pri)'};opacity:${done?'1':'.3'}">${r.id}</div>
      </div>
      <button class="rpt-toggle ${done?'done':'todo'}" onclick="toggleReport(${r.id})">${done?'✓ 已完成':'标记完成'}</button>
    `;
