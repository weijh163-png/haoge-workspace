<!-- ==================== Module 7: Flowchart & Review (archify integration) ==================== -->
<section class="module" id="flowchart">
  <div class="card">
    <div class="card-title"><span class="ico">🔀</span> 月度工作流程图 <span style="font-size:11px;font-weight:400;color:var(--muted);margin-left:auto">archify engine</span></div>
    <div class="section-hint">基于 archify JSON IR 渲染引擎的交互式工作流图。点击节点查看详情，悬停高亮路径，支持缩放和深浅主题切换。</div>
    <div class="fc-toolbar">
      <button class="fc-btn active" onclick="fcSetView('full')" id="fcViewFull">全流程</button>
      <button class="fc-btn" onclick="fcSetView('report')" id="fcViewReport">报表期(1-5号)</button>
      <button class="fc-btn" onclick="fcSetView('tax')" id="fcViewTax">税务申报(9-10号)</button>
      <button class="fc-btn" onclick="fcSetView('reconcile')" id="fcViewReconcile">月末扎口(30号)</button>
      <span style="flex:1"></span>
      <button class="fc-btn" onclick="fcZoom(0.15)" title="放大">+</button>
      <button class="fc-btn" onclick="fcZoom(-0.15)" title="缩小">-</button>
      <button class="fc-btn" onclick="fcZoomReset()" title="重置">重置</button>
      <button class="fc-btn" onclick="fcToggleTheme()" id="fcThemeBtn">深色主题</button>
      <button class="fc-play-btn" onclick="fcPlayStory()" id="fcPlayBtn"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M8 5v14l11-7z"/></svg><span id="fcPlayLabel">演示故事</span></button>
      <button class="fc-btn" onclick="fcToggleFlow()" id="fcFlowBtn">动态流动</button>
      <button class="fc-btn" onclick="fcExportPNG()">导出PNG</button>
    </div>
    <div class="fc-svg-wrap" id="fcSvgWrap">
      <div style="text-align:center;padding:60px;color:var(--muted);font-size:13px" id="fcLoading">正在渲染工作流图...</div>
    </div>
    <div class="fc-legend" id="fcLegend"></div>
    <div class="fc-info-panel" id="fcInfoPanel">
      <div class="fc-info-title">点击节点查看详情</div>
      <div class="fc-info-body">将鼠标悬停在节点上可高亮关联路径，点击节点可查看该工作项的详细说明、负责环节和时间节点。</div>
    </div>
  </div>

  <div class="card">
    <div class="card-title"><span class="ico">📋</span> archify JSON IR 数据源</div>
    <div class="section-hint">工作流图由以下 JSON IR 数据驱动渲染（借鉴 archify schema_version 2 格式）。可编辑后重新渲染。</div>
    <div class="calc-box">
      <div style="display:flex;gap:8px;margin-bottom:8px">
        <button class="btn btn-pri btn-sm" onclick="fcRenderDiagram()">重新渲染</button>
        <button class="btn btn-outline btn-sm" onclick="fcExportJSON()">导出JSON</button>
        <button class="btn btn-outline btn-sm" onclick="fcResetData()">恢复默认数据</button>
      </div>
      <textarea id="fcJsonEditor" style="width:100%;height:180px;font-size:11px;font-family:Consolas,monospace;border:1px solid var(--border);border-radius:8px;padding:10px;resize:vertical;outline:none" spellcheck="false"></textarea>
    </div>
  </div>

  <div class="card">
    <div class="card-title"><span class="ico">📝</span> 月度工作复盘</div>
    <div class="section-hint">每月工作结束后填写复盘记录，数据保存在本地浏览器。可对比多月趋势，复制复盘文本用于汇报。</div>
    <div style="display:flex;gap:10px;align-items:center;margin-bottom:12px;flex-wrap:wrap">
      <label style="font-size:12px;color:var(--muted)">复盘月份：</label>
      <select class="fc-month-select" id="fcReviewMonth" onchange="fcLoadReview()"></select>
      <button class="btn btn-pri btn-sm" onclick="fcSaveReview()">保存复盘</button>
      <button class="btn btn-outline btn-sm" onclick="fcCopyReview()">复制复盘文本</button>
      <button class="btn btn-outline btn-sm" onclick="fcClearReview()">清空本月</button>
    </div>
    <div class="fc-review-grid">
      <div class="fc-review-item">
        <h5>✅ 本月完成情况</h5>
        <textarea id="rvDone" placeholder="6份报表是否按时提交？税务是否按时申报？扎口是否完成？记录关键完成项..."></textarea>
      </div>
      <div class="fc-review-item">
        <h5>⚠️ 异常与问题</h5>
        <textarea id="rvIssues" placeholder="本月发现的异常：借贷负数、税差、收入不符、项目未了事项等..."></textarea>
      </div>
      <div class="fc-review-item">
        <h5>🔧 改进措施</h5>
        <textarea id="rvImprove" placeholder="下月需要改进的事项、流程优化建议..."></textarea>
      </div>
      <div class="fc-review-item">
        <h5>💡 经验总结</h5>
        <textarea id="rvLessons" placeholder="学到的新知识、发现的规律、优化后的效果..."></textarea>
      </div>
    </div>
    <div style="margin-top:10px;font-size:12px;color:var(--muted)" id="rvStats"></div>
  </div>

  <div class="card">
    <div class="card-title"><span class="ico">📊</span> 多月趋势对比</div>
    <div class="section-hint">展示最近6个月复盘记录的字数趋势，点击月份可跳转查看详情。</div>
    <div id="rvTrend" style="display:flex;gap:6px;flex-wrap:wrap;min-height:60px;align-items:flex-end"></div>
  </div>
</section>

</div>

<div class="toast" id="toast"></div>

<!-- Exam Countdown Modal -->
<div id="examModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.45);z-index:200;align-items:center;justify-content:center" onclick="closeExamModal(event)">
  <div style="background:var(--card);border-radius:var(--radius);box-shadow:0 20px 60px rgba(0,0,0,.2);padding:24px;max-width:480px;width:90%;position:relative;animation:modalIn .3s ease" onclick="event.stopPropagation()">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
      <div class="card-title" style="margin:0"><span class="ico">📚</span> 全部考试倒计时</div>
      <button style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--muted);padding:4px" onclick="closeExamModal()">×</button>
    </div>
    <div style="display:flex;flex-direction:column;gap:12px">
      <div style="background:linear-gradient(135deg,#7c3aed,#a78bfa);color:#fff;border-radius:8px;padding:16px;text-align:center">
        <div style="font-size:32px;font-weight:800" id="jingjiDaysModal">-</div>
        <div style="font-size:14px;font-weight:600;margin-top:4px">中级经济师</div>
        <div style="font-size:11px;opacity:.8">2026年11月7-8日</div>
      </div>
      <div style="background:linear-gradient(135deg,#0d9488,#34d399);color:#fff;border-radius:8px;padding:16px;text-align:center">
        <div style="font-size:32px;font-weight:800" id="shuiwuDaysModal">-</div>
        <div style="font-size:14px;font-weight:600;margin-top:4px">税务师三科</div>
        <div style="font-size:11px;opacity:.8">2026年11月14-15日</div>
      </div>
    </div>
    <div style="margin-top:16px;text-align:center;font-size:12px;color:var(--muted)">每天更新 · 祝你备考顺利</div>
  </div>
</div>
<style>
@keyframes modalIn{from{opacity:0;transform:translateY(-20px) scale(.95)}to{opacity:1;transform:translateY(0) scale(1)}}
</style>

<script>
// ==================== Data ====================
const MONTHLY_TASKS = [
  {day:1,tasks:[
    {t:'完成上月31日（或月末最后一天）的银行回单录入',pri:'high'},
    {t:'开始银行对账',pri:'high'},
    {t:'催促自然月结算的项目提交项目报表和在用友软件中做好收款计划',pri:'high'}
  ]},
  {day:2,tasks:[
    {t:'核对各项目报表中"分组作业消费产值+当月跨期开票差额"之和与项目上报的报表数据是否一致',pri:'high'},
    {t:'完成核对上月科桥餐饮公司各项指标明细（全额营业额）——综合部发送原稿',pri:'high'},
    {t:'根据上表完成科桥餐饮公司各项指标明细（按营业额计算各成本费用）——只填营业额部分，成本部分不用管',pri:'high'}
  ]},
  {day:3,tasks:[
    {t:'完成科桥餐饮项目营业额统计分析表（当月数+累计）——报成本核算科&管理一科',pri:'high'},
    {t:'完成科桥餐饮项目同期营业额统计分析表（当月+累计+2025年对比）——报管理一科',pri:'high'}
  ]},
  {day:4,tasks:[
    {t:'完成餐饮公司经营情况异常问题分类分工汇总【定稿】',pri:'high'},
    {t:'完成三个应收账款统计表（科桥餐饮公司、利得行、科桥空调）',pri:'high'},
    {t:'复核应收账款统计表（科桥汽车服务、东吴建筑）——与科目余额表核对',pri:'mid'}
  ]},
  {day:5,tasks:[
    {t:'将应收账龄分析表发给各项目，要求项目催收应收账款',pri:'mid'},
    {t:'核对应收账款明细与项目实际应收账款是否一致',pri:'mid'},
    {t:'【截止5号前】完成3家餐饮公司统计报表报送',pri:'high'},
    {t:'【截止5号前】完成2家东吴服务公司税金预估报送',pri:'high'},
    {t:'兰州博习/甘肃科桥/兰州莘源 统计申报（统计云+电子台账，工资数据由人资提供）',pri:'high'}
  ]},
  {day:6,tasks:[
    {t:'催项目将项目报表签字版本提供，确保不要有遗漏（5-7号）',pri:'mid'}
  ]},
  {day:7,tasks:[
    {t:'催项目将项目报表签字版本提供（5-7号最后一天）',pri:'mid'},
    {t:'【截止8号前】提醒好哒、迅付、富友三家第三方收款平台的项目：根据收款总额扣减上月已开票金额，剩余差额补开票',pri:'high'}
  ]},
  {day:8,tasks:[
