        <span style="font-weight:600">¥${u.amount}</span>
      </div>
      <div style="font-size:11px;color:var(--muted)">状态：${u.status}</div>
    `;
    container.appendChild(div);
  });
}

// ==================== Statistical Filing Toggle ====================
function toggleStat(id){
  const el = document.getElementById('stat' + id);
  if(!el) return;
  const done = el.classList.toggle('done');
  state.tasks['stat_' + id] = done;
  saveData();
  el.querySelector('.tx-status').textContent = done ? '✓ 已申报' : '月度统计申报 · 统计云+电子台账';
}

