// ==================== State ====================
const STORAGE_KEY = 'haoge_workspace_v2';
let state = {
  tasks: {},
  reports: {},
  tax: {},
  reportData: []
};
REPORTS.forEach(r => { state.reports[r.id] = Object.assign({done:false}, state.reports[r.id] || {}); });
TAX_COMPANIES.forEach(c => { state.tax[c.id] = Object.assign({done:false}, state.tax[c.id] || {}); });

function saveData(){ try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }catch(e){} }
function loadData(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);
    if(raw){
      const p = JSON.parse(raw);
      if(p.tasks) state.tasks = p.tasks;
      if(p.reports) state.reports = Object.assign({}, state.reports, p.reports);
      if(p.tax) state.tax = Object.assign({}, state.tax, p.tax);
      if(p.reportData) state.reportData = p.reportData;
    }
  }catch(e){}
}

// ==================== Navigation ====================
function switchTab(name){
  const tabs = ['dashboard','workflow','assistant','reports','projects','flowchart','extra'];
  document.querySelectorAll('.nav-tab').forEach((t,i) => {
    t.classList.remove('active');
    if(tabs[i] === name) t.classList.add('active');
  });
  document.querySelectorAll('.module').forEach(m => {
    m.classList.remove('active');
    if(m.id === name) m.classList.add('active');
  });
}

// ==================== Date & Today ====================
function getTodayDay(){
  return new Date().getDate();
}

function updateDateDisplay(){
  const now = new Date();
  const days = ['日','一','二','三','四','五','六'];
  document.getElementById('navDate').textContent = `${now.getFullYear()}年${now.getMonth()+1}月${now.getDate()}日 周${days[now.getDay()]}`;
  const td = document.getElementById('todayDay');
  if(td) td.textContent = now.getDate() + '日';
  const dl = document.getElementById('todayDateLabel');
  if(dl) dl.textContent = `${now.getMonth()+1}月${now.getDate()}日`;

  // Update date line in dashboard
  const dateLine = document.getElementById('dateLine');
  if(dateLine){
    const today = now.getDate();
    const closeDay = 30;
    const daysToClose = closeDay - today;
    const shuiwuExam = new Date('2026-11-14');
    const examDays = Math.ceil((shuiwuExam - now)/(1000*60*60*24));
    dateLine.textContent = `${now.getFullYear()}年${now.getMonth()+1}月${now.getDate()}日 周${days[now.getDay()]} · 距结账 ${daysToClose > 0 ? daysToClose : 0} 天 · 距税务师考试 ${examDays > 0 ? examDays : 0} 天`;
  }

  // Exam countdowns
  const jingjiExam = new Date('2026-11-07');
  const shuiwuExam = new Date('2026-11-14');
  const jd = document.getElementById('jingjiDays');
  const sd = document.getElementById('shuiwuDays');
  if(jd){
    const d = Math.ceil((jingjiExam - now)/(1000*60*60*24));
    jd.textContent = d > 0 ? d + '天' : '已结束';
  }
  if(sd){
    const d = Math.ceil((shuiwuExam - now)/(1000*60*60*24));
    sd.textContent = d > 0 ? d + '天' : '已结束';
  }
}

// ==================== Today's Tasks ====================
function renderTodayTasks(){
  const today = getTodayDay();
  const container = document.getElementById('todayTasks');
  const donePanel = document.getElementById('doneTasksList');
  const doneCount = document.getElementById('doneCount');
  const todoCnt = document.getElementById('todoCnt');
  if(!container) return;
  container.innerHTML = '';
  if(donePanel) donePanel.innerHTML = '';

  const dayData = MONTHLY_TASKS.find(d => d.day === today);
  if(!dayData){
    container.innerHTML = '<div style="text-align:center;color:var(--muted);padding:12px;font-size:12px">今日无特定日期任务，执行每日常规工作</div>';
    if(todoCnt) todoCnt.textContent = '0 项';
    document.getElementById('taskCountHero').textContent = '0';
    if(doneCount) doneCount.textContent = '0';
    return;
  }

  let todoCount = 0, doneItems = [];
  dayData.tasks.forEach((task, i) => {
    const key = 'd' + today + '_' + i;
    const done = state.tasks[key];
    if(!done) todoCount++;
    else doneItems.push(task);
    
    // Render todo items
    if(!done){
      const div = document.createElement('div');
      div.className = 'day-task';
      const priMap = {high:'紧急',mid:'重要',low:'日常'};
      const tagCls = task.pri === 'high' ? 'tag-p' : task.pri === 'mid' ? 'tag-m' : '';
      div.innerHTML = `
        <input type="checkbox" class="dt-check" onchange="toggleDayTask('${key}')">
        <span class="dt-text">${task.t}</span>
        <span class="dt-pri ${task.pri}">${priMap[task.pri]}</span>
      `;
      container.appendChild(div);
    }
  });
  
  // Render done items in done-list
  if(donePanel){
    doneItems.forEach(task => {
      const div = document.createElement('div');
      div.className = 'todo-item done';
      div.innerHTML = `<input type="checkbox" checked><div class="nm">${task.t}</div>`;
      donePanel.appendChild(div);
    });
  }
  
  if(todoCnt) todoCnt.textContent = todoCount + ' 项';
  document.getElementById('taskCountHero').textContent = todoCount;
  if(doneCount) doneCount.textContent = doneItems.length;
}

function toggleDayTask(key){
  state.tasks[key] = !state.tasks[key];
  saveData();
  renderTodayTasks();
  renderDynamicAlerts();
  updateTaxProgress();
}

// ==================== Workflow Timeline ====================
function renderTimeline(){
  const container = document.getElementById('timelineSection');
  if(!container) return;
  const today = getTodayDay();
  const phases = [
    {label:'申报期（1-10号）',icon:'\uD83D\uDD25',cls:'tl-grp-deadline',range:[1,10]},
    {label:'常规期（11-25号）',icon:'\u2699\uFE0F',cls:'tl-grp-routine',range:[11,25]},
    {label:'结账期（26-30号）',icon:'\uD83D\uDCCA',cls:'tl-grp-closing',range:[26,30]}
  ];
  let html = '';
  phases.forEach(ph => {
    const days = MONTHLY_TASKS.filter(d => d.day >= ph.range[0] && d.day <= ph.range[1]);
    if(!days.length) return;
    const hasToday = days.some(d => d.day === today);
    html += `<div class="tl-grp ${ph.cls}${hasToday?' grp-active':''}">
      <div class="tl-grp-head" onclick="toggleGrp(this)">
        <span class="tl-grp-ico">${ph.icon}</span>
        <span class="tl-grp-label">${ph.label}</span>
        <span class="tl-grp-count">${days.length} 天</span>
        <span class="tl-grp-arrow">\u25B6</span>
      </div>
      <div class="tl-grp-body">`;
    days.forEach(d => {
      const isToday = d.day === today;
      const highCnt = d.tasks.filter(t => t.pri==='high').length;
      let badge = '';
      if(d.day===3) badge = '<span class="badge badge-red">报表截止</span>';
      if(d.day===5) badge = '<span class="badge badge-amber">统计截止</span>';
      if(d.day===8) badge = '<span class="badge badge-amber">补开票截止</span>';
      if(d.day===10) badge = '<span class="badge badge-red">税务截止</span>';
      const tasksHtml = d.tasks.map(t => {
        const priLabel = t.pri==='high'?'高':t.pri==='mid'?'中':'低';
        return `<div class="tl-task ${t.pri}"><span class="task-text">${t.t}</span><span class="task-pri">${priLabel}</span></div>`;
      }).join('');
      const summary = d.tasks.length > 1
        ? `${d.tasks[0].t.substring(0,28)}${d.tasks[0].t.length>28?'...':''} <span style="color:var(--muted);font-weight:400">+${d.tasks.length-1}项</span>`
        : d.tasks[0].t.substring(0,40);
      html += `
        <div class="tl-phase${isToday?' today':''}${isToday?' expanded':''}" id="tlDay${d.day}">
          <div class="tl-dot"></div>
          <div class="tl-header" onclick="togglePhase(${d.day})">
            <span class="tl-time">${d.day}号</span>
            <span class="tl-name">${summary}</span>
            <span class="tl-badge-group">${badge}</span>
            ${highCnt>0?`<span class="badge badge-red" style="font-size:10px">${highCnt}高优</span>`:''}
            ${isToday?'<span class="badge badge-amber">今日</span>':''}
            <span class="tl-arrow">\u25B6</span>
          </div>
          <div class="tl-body">${tasksHtml}</div>
        </div>`;
    });
    html += `</div></div>`;
  });
  container.innerHTML = html;
}

function toggleGrp(headEl){
  const grp = headEl.parentElement;
  grp.classList.toggle('grp-collapsed');
}

function togglePhase(day){
  document.getElementById('tlDay' + day).classList.toggle('expanded');
}

// ==================== Cycle Table ====================
function renderCycleTable(){
  const container = document.getElementById('cycleTable');
  if(!container) return;
  const keyDates = [
    {day:'1号',task:'银行回单录入+对账+催自然月结算项目报表',pri:'高'},
    {day:'2号',task:'核对分组作业+跨期差额一致；指标明细核对与填报',pri:'高'},
    {day:'3号',task:'营业额统计分析表+同期营业额统计分析表',pri:'高'},
    {day:'4号',task:'异常问题分类分工汇总定稿+三个应收账款统计表',pri:'高'},
    {day:'5号',task:'应收账龄发项目催收；3家餐饮统计报表+2家税金预估报送',pri:'高'},
    {day:'5-7号',task:'催项目报表签字版本',pri:'中'},
    {day:'8号前',task:'好哒/迅付/富友第三方收款补开票提醒',pri:'高'},
    {day:'10号前',task:'7家公司税务+个税申报（先个税），同步填表',pri:'高'},
    {day:'20号',task:'装订上月凭证',pri:'中'},
    {day:'26号',task:'催25日核算项目提交报表和收款计划',pri:'高'},
    {day:'30号',task:'销项税额+总账收入与开票系统核对',pri:'高'}
  ];
  container.innerHTML = keyDates.map(k => `
    <div class="ct-card ${k.pri==='高'?'ct-high':'ct-mid'}">
      <div class="ct-day">${k.day}</div>
      <div class="ct-task">${k.task}</div>
      <div class="ct-pri">${k.pri}</div>
    </div>
  `).join('');
}

// ==================== Notices ====================
function renderNotices(){
  const container = document.getElementById('noticeList');
  if(!container) return;
  container.innerHTML = '';
  NOTICES.forEach((n, i) => {
    const div = document.createElement('div');
    div.className = 'notice-card';
    div.id = 'notice' + i;
    div.innerHTML = `
      <div class="nc-head" onclick="toggleNotice(${i})">
        <div class="nc-num">${i+1}</div>
        <div class="nc-title">${n.title}</div>
        <span class="nc-arrow">▶</span>
      </div>
      <div class="nc-body">${n.body.replace(/\n/g,'<br>')}</div>
    `;
    container.appendChild(div);
  });
}

function toggleNotice(i){
  document.getElementById('notice' + i).classList.toggle('expanded');
}

// ==================== Tax ====================
function renderTaxGrid(){
  const container = document.getElementById('taxGrid');
  if(!container) return;
  container.innerHTML = '';
  TAX_COMPANIES.forEach(c => {
    const done = state.tax[c.id]?.done;
    const div = document.createElement('div');
    div.className = 'tax-item' + (done ? ' done' : '') + (!c.active ? ' cancelled' : '');
    if(c.active){
      div.onclick = () => toggleTax(c.id);
    }
    div.innerHTML = `
      <div class="tx-name">${c.short}</div>
      <div class="tx-status">${!c.active ? c.note : (done ? '✓ 已完成' : '待申报')}</div>
      ${c.active ? `<div style="font-size:10px;color:var(--muted);margin-top:2px">${c.freq}</div>` : ''}
    `;
    container.appendChild(div);
  });
  updateTaxProgress();
}

function toggleTax(id){
  state.tax[id].done = !state.tax[id].done;
  saveData();
  renderTaxGrid();
  updateTaxProgress();
  showToast(state.tax[id].done ? '税务已标记完成' : '已取消完成');
}

function toggleTaxManualDone(){
  const active = TAX_COMPANIES.filter(c => c.active);
  const allDone = active.every(c => state.tax[c.id]?.done);
  active.forEach(c => { state.tax[c.id] = Object.assign(state.tax[c.id] || {}, {done:!allDone}); });
  saveData();
  updateTaxProgress();
  renderTaxGrid();
  const btn = document.getElementById('taxManualBtn');
  if(btn){
    btn.textContent = allDone ? '手动标记已完成' : '取消手动完成';
    btn.className = allDone ? 'btn btn-sm' : 'btn btn-sm btn-success';
  }
  showToast(allDone ? '已取消手动完成' : '已手动标记所有税务申报完成');
}

function updateTaxProgress(){
  const active = TAX_COMPANIES.filter(c => c.active);
  let done = active.filter(c => state.tax[c.id]?.done).length;
  const taxTaskDone = MONTHLY_TASKS.some(d => {
    const idx = d.tasks.findIndex(t => t.t.includes('税务申报'));
    return idx >= 0 && state.tasks['d'+d.day+'_'+idx];
  });
  if(taxTaskDone && done === 0) done = active.length;
  const total = active.length;
  const pct = total === 0 ? 0 : Math.round((done / total) * 100);
  const mini = document.getElementById('taxMini');
  const bar = document.getElementById('taxBar');
  const ring = document.getElementById('taxRing');
  if(mini) mini.textContent = done + '/' + total;
  if(bar) bar.style.width = pct + '%';
  if(ring) ring.style.setProperty('--v', pct);
}

function updateReportProgress(){
  const done = REPORTS.filter(r => state.reports[r.id]?.done).length;
  const pct = Math.round((done / REPORTS.length) * 100);
  const mini = document.getElementById('progMini');
  const bar = document.getElementById('progBar');
  const ring = document.getElementById('reportRing');
  if(mini) mini.textContent = done + '/7';
  if(bar) bar.style.width = pct + '%';
  if(ring) ring.style.setProperty('--v', pct);
  const rp = document.getElementById('reportProgress');
  if(rp) rp.textContent = done + '/7';
  // Update hero
  const rh = document.getElementById('reportHero');
  if(rh) rh.textContent = done + '/7';
}

// ==================== Dynamic Alerts ====================
function renderDynamicAlerts(){
  const container = document.getElementById('dynamicAlerts');
  if(!container) return;
  const today = getTodayDay();
  const dayData = MONTHLY_TASKS.find(d => d.day === today);
  const alerts = [];
  if(dayData){
    const ts = dayData.tasks.map(t => t.t).join(' ');
    if(ts.includes('应收')) alerts.push({ico:'⚡',txt:'应收三表：空调公式 / 利得行跨期 / 餐饮覆盖期间',bg:'var(--red-l)',c:'var(--red)'});
    if(ts.includes('税务') || ts.includes('个税')) alerts.push({ico:'🏢',txt:'先个税→再增值税及附加→填腾讯文档税金确认表',bg:'var(--amber-l)',c:'var(--amber)'});
    if(ts.includes('营业额')) alerts.push({ico:'📊',txt:'差额营业额 = 账面 + 阳澄湖/华扬/博习应收借方',bg:'var(--pri-l)',c:'var(--pri)'});
    if(ts.includes('开票')) alerts.push({ico:'📋',txt:'第三方收款补开票：总额扣减上月已开票',bg:'var(--teal-l)',c:'var(--teal)'});
  }
  if(alerts.length === 0){
    alerts.push({ico:'✅',txt:'常规期：每日开票制单 + 银行回单 + 回款通知',bg:'var(--green-l)',c:'var(--green)'});
  }
  container.innerHTML = alerts.map(a => `<div style="display:flex;align-items:center;gap:8px;padding:6px 10px;border-radius:6px;background:${a.bg};margin-bottom:4px;font-size:12px"><span>${a.ico}</span><span style="color:${a.c};font-weight:500">${a.txt}</span></div>`).join('');
}

// ==================== Done Panel & Exam Modal ====================
function toggleDonePanel(){
  const panel = document.getElementById('doneTasksList');
  if(!panel) return;
  panel.classList.toggle('open');
}

function openExamModal(){
  const modal = document.getElementById('examModal');
  if(!modal) return;
  modal.style.display = 'flex';
  const now = new Date();
  const jingji = new Date('2026-11-07');
  const shuiwu = new Date('2026-11-14');
  const jm = document.getElementById('jingjiDaysModal');
  const sm = document.getElementById('shuiwuDaysModal');
  const toDays = (d) => { const n = Math.ceil((d - now)/(1000*60*60*24)); return n > 0 ? n + '天' : '已结束'; };
  if(jm) jm.textContent = toDays(jingji);
  if(sm) sm.textContent = toDays(shuiwu);
}

function closeExamModal(e){
  if(e && e.target !== e.currentTarget) return;
  const modal = document.getElementById('examModal');
  if(modal) modal.style.display = 'none';
}

// ==================== Reports ====================
function renderReportCards(){
  const container = document.getElementById('reportCardsList');
  if(!container) return;
  container.innerHTML = '';
  REPORTS.forEach(r => {
    const done = state.reports[r.id]?.done;
    const card = document.createElement('div');
    card.className = 'rpt-card' + (done ? ' done' : '');
    card.innerHTML = `
      <div class="report-head">
