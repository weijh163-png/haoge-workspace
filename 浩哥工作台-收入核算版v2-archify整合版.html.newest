  REPORTS.forEach(r => { state.reports[r.id] = Object.assign(state.reports[r.id] || {}, {done:!allDone}); });
  saveData();
  updateReportProgress();
  renderReportCards();
  renderTodayTasks();
  showToast(allDone ? '已取消所有报表完成标记' : '已手动标记所有报表完成');
}

// ==================== Exception Report Generator ====================
// --- XLSX Parser (ZIP + DEFLATE + XML, no external deps) ---
async function inflateRaw(compressed){
  const stream = new ReadableStream({
    start(c){ c.enqueue(compressed); c.close(); }
  }).pipeThrough(new DecompressionStream('deflate-raw'));
  const buf = await new Response(stream).arrayBuffer();
  return new Uint8Array(buf);
}
function colRefToIdx(ref){
  const m = ref.match(/([A-Z]+)/);
  if(!m) return 0;
  let idx = 0;
  for(let i=0;i<m[1].length;i++) idx = idx*26 + (m[1].charCodeAt(i)-64);
  return idx - 1;
}
async function parseZIP(arrayBuffer){
  const view = new DataView(arrayBuffer);
  const files = {};
  let offset = 0;
  while(offset < arrayBuffer.byteLength - 4){
    if(view.getUint32(offset, true) !== 0x04034b50) break;
    const compMethod = view.getUint16(offset+8, true);
    const compSize = view.getUint32(offset+18, true);
    const uncompSize = view.getUint32(offset+22, true);
    const fnLen = view.getUint16(offset+26, true);
    const efLen = view.getUint16(offset+28, true);
    const fileName = new TextDecoder('utf-8').decode(new Uint8Array(arrayBuffer, offset+30, fnLen));
    const dataOffset = offset + 30 + fnLen + efLen;
    if(compMethod === 0){
      files[fileName] = new Uint8Array(arrayBuffer, dataOffset, uncompSize);
    } else if(compMethod === 8){
      files[fileName] = await inflateRaw(new Uint8Array(arrayBuffer, dataOffset, compSize));
    }
    offset = dataOffset + compSize;
  }
  return files;
}
async function parseXLSXFile(file){
  const arrayBuffer = await file.arrayBuffer();
  const files = await parseZIP(arrayBuffer);
  // sharedStrings
  let sharedStrings = [];
  if(files['xl/sharedStrings.xml']){
    const xml = new TextDecoder('utf-8').decode(files['xl/sharedStrings.xml']);
    const doc = new DOMParser().parseFromString(xml, 'text/xml');
    doc.querySelectorAll('si').forEach(si => {
      const ts = si.querySelectorAll('t');
      let text = '';
      ts.forEach(t => text += (t.textContent || ''));
      sharedStrings.push(text);
    });
  }
  // workbook sheet names
  let sheetNames = [];
  if(files['xl/workbook.xml']){
    const xml = new TextDecoder('utf-8').decode(files['xl/workbook.xml']);
    const doc = new DOMParser().parseFromString(xml, 'text/xml');
    doc.querySelectorAll('sheet').forEach(s => sheetNames.push(s.getAttribute('name') || ''));
  }
  // parse worksheets
  const sheets = [];
  for(let i=1; i<=20; i++){
    const key = 'xl/worksheets/sheet'+i+'.xml';
    if(!files[key]) break;
    const xml = new TextDecoder('utf-8').decode(files[key]);
    const doc = new DOMParser().parseFromString(xml, 'text/xml');
    const rows = [];
    doc.querySelectorAll('row').forEach(row => {
      const rowData = [];
      row.querySelectorAll('c').forEach(cell => {
        const ref = cell.getAttribute('r') || '';
        const type = cell.getAttribute('t');
        const vEl = cell.querySelector('v');
        const isEl = cell.querySelector('is');
        let value = '';
        if(type === 's' && vEl){
          value = sharedStrings[parseInt(vEl.textContent)] || '';
        } else if(type === 'inlineStr' && isEl){
          const t = isEl.querySelector('t');
          value = t ? t.textContent : '';
        } else if(vEl){
          value = vEl.textContent;
        }
        const colIdx = colRefToIdx(ref);
        rowData[colIdx] = value;
      });
      rows.push(rowData);
    });
    sheets.push({name: sheetNames[i-1] || ('Sheet'+i), rows});
  }
  return sheets;
}
// --- End XLSX Parser ---

// --- Exception Report Rules ---
const EXCEPTION_PROJECTS = [
  'CF101','CF102','CF108','CF120','CF121','CF122','CF134','CF272','CF293','CF320',
  'CF360','CF363','CF364','CF474','CF620','CF640','CF641','CF699','CF781','CF251','CF450'
];
let importedData = null;

function parseSheetRows(rows){
  const data = {};
  rows.forEach(row => {
    const code = row[0];
    if(code && typeof code === 'string' && code.startsWith('CF')){
      data[code] = {
        name: row[1] || '',
        rev: parseFloat(row[4]) || 0,     // E: 合计=营业额
        ded: parseFloat(row[5]) || 0,      // F: 代收代扣=代扣款
        diff: parseFloat(row[6]) || 0,     // G: 差额
        rev2026: parseFloat(row[7]) || 0,  // H: 2026年差额营业额
        yoy: parseFloat(row[8]) || 0       // I: 增减
      };
    }
  });
  return data;
}

async function handleFileImport(event){
  const file = event.target.files[0];
  if(!file) return;
  const statusEl = document.getElementById('importStatus');
  statusEl.textContent = '正在解析...';
  statusEl.style.color = 'var(--pri)';
  try{
    const sheets = await parseXLSXFile(file);
    let monthSheet = null, cumSheet = null;
    sheets.forEach(s => {
      const title = (s.rows[0] && s.rows[0][0]) || s.name;
      if(title.includes('当月') || s.name.includes('当月')) monthSheet = s;
      if(title.includes('累计') || s.name.includes('累计')) cumSheet = s;
    });
    if(!monthSheet && !cumSheet){
      statusEl.textContent = '未找到"当月"或"累计"Sheet';
      statusEl.style.color = 'var(--red)';
      return;
    }
    importedData = {month:{}, cum:{}};
    if(monthSheet) importedData.month = parseSheetRows(monthSheet.rows);
    if(cumSheet) importedData.cum = parseSheetRows(cumSheet.rows);
    const mCount = Object.keys(importedData.month).length;
    const cCount = Object.keys(importedData.cum).length;
    statusEl.textContent = `导入成功：当月${mCount}项，累计${cCount}项`;
    statusEl.style.color = 'var(--green)';
    // Enable generate button
    const btn = document.getElementById('genFromImportBtn');
    btn.disabled = false;
    btn.style.opacity = '1';
    // Show preview
    const preview = document.getElementById('importPreview');
    preview.style.display = 'block';
    let html = '<div style="font-size:12px;font-weight:600;margin-bottom:4px">导入数据预览（21个标准项目）</div>';
    html += '<table style="width:100%;border-collapse:collapse;font-size:11px"><thead><tr style="background:var(--slate-l)">';
    html += '<th style="padding:3px 6px;text-align:left">编码</th><th style="padding:3px 6px;text-align:left">项目</th>';
    html += '<th style="padding:3px 6px;text-align:right">当月营业额</th><th style="padding:3px 6px;text-align:right">当月代扣</th>';
    html += '<th style="padding:3px 6px;text-align:right">当月差额</th><th style="padding:3px 6px;text-align:right">累计营业额</th>';
    html += '<th style="padding:3px 6px;text-align:right">累计代扣</th><th style="padding:3px 6px;text-align:right">累计差额</th>';
    html += '</tr></thead><tbody>';
    EXCEPTION_PROJECTS.forEach(code => {
      const m = importedData.month[code];
      const c = importedData.cum[code];
      if(!m && !c) return;
      const name = (m||c).name;
      const fmt = v => v ? (v/10000).toFixed(2) : '-';
      html += '<tr style="border-bottom:1px solid var(--border)">';
      html += `<td style="padding:3px 6px;font-weight:600">${code}</td>`;
      html += `<td style="padding:3px 6px">${name}</td>`;
      html += `<td style="padding:3px 6px;text-align:right">${m?fmt(m.rev):'-'}</td>`;
      html += `<td style="padding:3px 6px;text-align:right">${m?fmt(m.ded):'-'}</td>`;
      html += `<td style="padding:3px 6px;text-align:right">${m?fmt(m.diff):'-'}</td>`;
      html += `<td style="padding:3px 6px;text-align:right">${c?fmt(c.rev):'-'}</td>`;
      html += `<td style="padding:3px 6px;text-align:right">${c?fmt(c.ded):'-'}</td>`;
      html += `<td style="padding:3px 6px;text-align:right">${c?fmt(c.diff):'-'}</td>`;
      html += '</tr>';
    });
    html += '</tbody></table>';
    preview.innerHTML = html;
    showToast('导入成功，可点击"从导入数据生成"');
  }catch(e){
    statusEl.textContent = '导入失败：' + e.message;
    statusEl.style.color = 'var(--red)';
    console.error(e);
  }
}

function fmtWan(yuan){
  return (yuan / 10000).toFixed(2);
}
function yoyStr(yoyYuan){
  const w = yoyYuan / 10000;
  if(Math.abs(w) < 0.005) return '营业额同比持平';
  return w > 0 ? `营业额同比增加${w.toFixed(2)}万元` : `营业额同比减少${Math.abs(w).toFixed(2)}万元`;
}

function generateFromImport(){
  if(!importedData){ showToast('请先导入Excel文件'); return; }
  const month = parseInt(document.getElementById('genMonth').value);
  const lastYear = document.getElementById('genLastYear').value;
  const thisYear = document.getElementById('genThisYear').value;
  const cumMonth = parseInt(document.getElementById('genCumMonth').value);
  let output = '';
  let entryNum = 0;
  EXCEPTION_PROJECTS.forEach(code => {
    const m = importedData.month[code];
    const c = importedData.cum[code];
    if(!m && !c) return;
    const name = (m || c).name;
    // CF251/CF450 only have cumulative entries
    const hasMonth = m && !['CF251','CF450'].includes(code) && (Math.abs(m.rev) > 0.01 || Math.abs(m.diff) > 0.01 || Math.abs(m.rev2026) > 0.01);
    if(hasMonth){
      entryNum++;
      output += `${entryNum}、${name}：`;
      output += `${lastYear}年${month}月营业额${fmtWan(m.rev)}万元，代扣款${fmtWan(m.ded)}万元，差额营业额${fmtWan(m.diff)}万元；`;
      output += `${thisYear}年${month}月差额营业额为${fmtWan(m.rev2026)}万元，${yoyStr(m.yoy)}\n`;
      if(c){
        entryNum++;
        output += `${entryNum}、${name}：`;
        output += `${lastYear}年1-${cumMonth}月累计营业额${fmtWan(c.rev)}万元，代扣款${fmtWan(c.ded)}万元，差额营业额${fmtWan(c.diff)}万元；`;
        output += `${thisYear}年1-${cumMonth}月累计差额营业额为${fmtWan(c.rev2026)}万元，${yoyStr(c.yoy)}\n`;
      }
    } else if(c){
      entryNum++;
      output += `${entryNum}、${name}：`;
      output += `${lastYear}年1-${cumMonth}月累计营业额${fmtWan(c.rev)}万元，代扣款${fmtWan(c.ded)}万元，差额营业额${fmtWan(c.diff)}万元；`;
      output += `${thisYear}年1-${cumMonth}月累计差额营业额为${fmtWan(c.rev2026)}万元，${yoyStr(c.yoy)}\n`;
    }
    output += '\n';
  });
  document.getElementById('genOutputArea').style.display = 'block';
  document.getElementById('genOutput').innerHTML = output.split('\n').filter(l => l.trim()).map(l => `<div class="proj-line">${l}</div>`).join('');
  showToast(`已生成 ${entryNum} 条异常说明`);
}

function addDataRow(){
  const maxId = state.reportData.length > 0 ? Math.max(...state.reportData.map(r=>r.id||0)) : 0;
  state.reportData.push({id:maxId+1, name:'', rev:'', ded:'', lastDiff:''});
  saveData();
  renderDataRows();
}

function removeDataRow(id){
  state.reportData = state.reportData.filter(r => r.id !== id);
  saveData();
  renderDataRows();
}

function updateDataRow(id, field, val){
  const row = state.reportData.find(r => r.id === id);
  if(row){ row[field] = val; saveData(); }
}

function renderDataRows(){
  const container = document.getElementById('dataRows');
  if(!container) return;
  container.innerHTML = '';
  if(state.reportData.length === 0){
    ['苏大本部方塔食堂','苏大东区四食堂','苏大北区六食堂'].forEach(name => {
      const maxId = state.reportData.length > 0 ? Math.max(...state.reportData.map(r=>r.id||0)) : 0;
      state.reportData.push({id:maxId+1, name:name, rev:'', ded:'', lastDiff:''});
    });
    saveData();
  }
  state.reportData.forEach(row => {
    const diff = (parseFloat(row.rev)||0) - (parseFloat(row.ded)||0);
    const diffStr = isNaN(diff) ? '-' : diff.toFixed(2);
    const div = document.createElement('div');
    div.className = 'calc-row';
    div.innerHTML = `
      <input type="text" value="${row.name||''}" placeholder="项目名称" onchange="updateDataRow(${row.id},'name',this.value)">
      <input type="number" value="${row.rev||''}" placeholder="0.00" step="0.01" onchange="updateDataRow(${row.id},'rev',this.value)">
      <input type="number" value="${row.ded||''}" placeholder="0.00" step="0.01" onchange="updateDataRow(${row.id},'ded',this.value)">
      <div class="calc-val">${diffStr}</div>
      <input type="number" value="${row.lastDiff||''}" placeholder="0.00" step="0.01" onchange="updateDataRow(${row.id},'lastDiff',this.value)">
      <button class="btn btn-outline btn-sm" onclick="removeDataRow(${row.id})" style="color:var(--red)">删</button>
    `;
    const revInput = div.children[1];
    const dedInput = div.children[2];
    const diffDiv = div.children[3];
    revInput.oninput = () => { diffDiv.textContent = ((parseFloat(revInput.value)||0)-(parseFloat(dedInput.value)||0)).toFixed(2); };
    dedInput.oninput = () => { diffDiv.textContent = ((parseFloat(revInput.value)||0)-(parseFloat(dedInput.value)||0)).toFixed(2); };
    container.appendChild(div);
  });
}

function generateExceptionReport(){
  const month = parseInt(document.getElementById('genMonth').value);
  const lastYear = document.getElementById('genLastYear').value;
  const thisYear = document.getElementById('genThisYear').value;
  const cumMonth = parseInt(document.getElementById('genCumMonth').value);
  if(state.reportData.length === 0){ showToast('请先添加项目数据'); return; }
  let output = '';
  let projCount = 0;
  const validRows = state.reportData.filter(r => r.name && (r.rev || r.lastDiff));
  validRows.forEach(row => {
    const rev = parseFloat(row.rev) || 0;
    const ded = parseFloat(row.ded) || 0;
    const diff = rev - ded;
    const lastDiff = parseFloat(row.lastDiff) || 0;
    const yoy = diff - lastDiff;
    projCount++;
    output += `${projCount}、${row.name}：`;
    output += `${lastYear}年${month}月营业额${rev.toFixed(2)}万元，代扣款${ded.toFixed(2)}万元，差额营业额${diff.toFixed(2)}万元；`;
    output += `${thisYear}年${month}月差额营业额为${diff.toFixed(2)}万元，`;
    if(Math.abs(yoy) < 0.005){
      output += `营业额同比持平\n`;
    } else {
      output += `营业额同比${yoy > 0 ? '增加' : '减少'}${Math.abs(yoy).toFixed(2)}万元\n`;
    }
    if(cumMonth !== month){
      projCount++;
      output += `${projCount}、${row.name}：`;
      output += `${lastYear}年1-${cumMonth}月累计营业额${rev.toFixed(2)}万元，代扣款${ded.toFixed(2)}万元，差额营业额${diff.toFixed(2)}万元；`;
      output += `${thisYear}年1-${cumMonth}月累计差额营业额为${diff.toFixed(2)}万元，`;
      if(Math.abs(yoy) < 0.005){
        output += `营业额同比持平\n`;
      } else {
        output += `营业额同比${yoy > 0 ? '增加' : '减少'}${Math.abs(yoy).toFixed(2)}万元\n`;
      }
    }
    output += '\n';
  });
  document.getElementById('genOutputArea').style.display = 'block';
  document.getElementById('genOutput').innerHTML = output.split('\n').filter(l => l.trim()).map(l => `<div class="proj-line">${l}</div>`).join('');
  showToast(`已生成 ${projCount} 条异常说明`);
}

function copyGenerated(){
  const text = document.getElementById('genOutput').innerText;
  if(!text){ showToast('请先生成'); return; }
  navigator.clipboard.writeText(text).then(() => showToast('已复制到剪贴板')).catch(() => {
    const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select();
    try{ document.execCommand('copy'); showToast('已复制'); }catch(e){ showToast('复制失败'); }
    document.body.removeChild(ta);
  });
}

function clearOutput(){
  document.getElementById('genOutputArea').style.display = 'none';
  document.getElementById('genOutput').innerHTML = '';
}

// ==================== Quick Calc ====================
function autoCalc(){
  const rev = parseFloat(document.getElementById('calcRev').value) || 0;
  const ded = parseFloat(document.getElementById('calcDed').value) || 0;
  const lastDiff = parseFloat(document.getElementById('calcLastDiff').value) || 0;
  const diff = rev - ded;
  const yoy = diff - lastDiff;
  document.getElementById('calcDiff').textContent = diff.toFixed(2);
  const yoyEl = document.getElementById('calcYoY');
  yoyEl.textContent = (yoy >= 0 ? '+' : '') + yoy.toFixed(2);
  yoyEl.style.background = yoy >= 0 ? 'var(--green-l)' : 'var(--red-l)';
  yoyEl.style.color = yoy >= 0 ? 'var(--green)' : 'var(--red)';
}

// ==================== Monthly Reset ====================
function resetMonthlyData(){
  if(!confirm('确认重置本月数据？报表状态、税务状态和异常说明数据将被清空。')) return;
  REPORTS.forEach(r => { state.reports[r.id] = {done:false}; });
  TAX_COMPANIES.forEach(c => { state.tax[c.id] = {done:false}; });
  state.reportData = [];
  state.tasks = {};
  saveData();
  renderReportCards();
  renderTaxGrid();
  renderTodayTasks();
  renderDataRows();
  showToast('本月数据已重置');
}

// ==================== Toast ====================
let toastTimer;
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2000);
}

