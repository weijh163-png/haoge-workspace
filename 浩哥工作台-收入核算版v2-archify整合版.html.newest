// Node type color mapping (archify semantic labels)
const FC_TYPE_COLORS = {
  frontend: { fill: '#dbeafe', stroke: '#2563eb', label: '前端/收款' },
  backend: { fill: '#ccfbf1', stroke: '#0d9488', label: '后端/制单' },
  security: { fill: '#fee2e2', stroke: '#ef4444', label: '关键/审核' },
  messagebus: { fill: '#fef3c7', stroke: '#f59e0b', label: '消息/税务' },
  database: { fill: '#f1f5f9', stroke: '#64748b', label: '数据/报表' },
  cloud: { fill: '#ede9fe', stroke: '#7c3aed', label: '外部/统计' }
};
const FC_DARK_COLORS = {
  frontend: { fill: '#1e3a5f', stroke: '#60a5fa', label: '前端/收款' },
  backend: { fill: '#134e4a', stroke: '#2dd4bf', label: '后端/制单' },
  security: { fill: '#7f1d1d', stroke: '#f87171', label: '关键/审核' },
  messagebus: { fill: '#78350f', stroke: '#fbbf24', label: '消息/税务' },
  database: { fill: '#334155', stroke: '#94a3b8', label: '数据/报表' },
  cloud: { fill: '#4c1d95', stroke: '#a78bfa', label: '外部/统计' }
};

// Renderer state
let fcIR = JSON.parse(JSON.stringify(FC_DEFAULT_IR));
let fcDarkMode = false;
let fcZoomLevel = 1;
let fcPanX = 0, fcPanY = 0;
let fcCurrentView = 'full';
let fcSelectedNode = null;

// Layout constants
const FC_LANE_HEIGHT = 110;
const FC_LANE_GAP = 20;
const FC_LANE_HEADER = 30;
const FC_COL_WIDTH = 220;
const FC_LEFT_MARGIN = 50;
const FC_TOP_MARGIN = 55;
const FC_NODE_HEIGHT = 52;
const FC_NODE_TAG_HEIGHT = 68;

function fcGetTypeColor(type) {
  const palette = fcDarkMode ? FC_DARK_COLORS : FC_TYPE_COLORS;
  return palette[type] || palette.backend;
}

function fcCalcLayout(ir) {
  const lanes = ir.lanes;
  const maxCol = Math.max(...ir.nodes.map(n => n.col));
  const cols = maxCol + 1;
  const svgWidth = FC_LEFT_MARGIN * 2 + cols * FC_COL_WIDTH + 20;
  const svgHeight = FC_TOP_MARGIN + lanes.length * (FC_LANE_HEIGHT + FC_LANE_GAP) + 80;
  return { svgWidth, svgHeight, cols, laneCount: lanes.length };
}

function fcNodePos(node, ir) {
  const laneIdx = ir.lanes.findIndex(l => l.id === node.lane);
  const x = FC_LEFT_MARGIN + node.col * FC_COL_WIDTH + (FC_COL_WIDTH - node.width) / 2;
  const y = FC_TOP_MARGIN + laneIdx * (FC_LANE_HEIGHT + FC_LANE_GAP) + FC_LANE_HEADER + 10;
  return { x, y, cx: x + node.width / 2, cy: y + (node.tag ? FC_NODE_TAG_HEIGHT : FC_NODE_HEIGHT) / 2 };
}

function fcBuildEdgePath(edge, ir) {
  const fromNode = ir.nodes.find(n => n.id === edge.from);
  const toNode = ir.nodes.find(n => n.id === edge.to);
  if (!fromNode || !toNode) return '';
  const from = fcNodePos(fromNode, ir);
  const toP = fcNodePos(toNode, ir);
  const fromH = fromNode.tag ? FC_NODE_TAG_HEIGHT : FC_NODE_HEIGHT;
  const toH = toNode.tag ? FC_NODE_TAG_HEIGHT : FC_NODE_HEIGHT;
  let x1, y1, x2, y2;
  const fromSide = edge.fromSide || 'right';
  const toSide = edge.toSide || 'left';
  if (fromSide === 'right') { x1 = from.x + fromNode.width; y1 = from.y + fromH / 2; }
  else if (fromSide === 'bottom') { x1 = from.cx; y1 = from.y + fromH; }
  else if (fromSide === 'top') { x1 = from.cx; y1 = from.y; }
  else if (fromSide === 'left') { x1 = from.x; y1 = from.y + fromH / 2; }
  else { x1 = from.x + fromNode.width; y1 = from.y + fromH / 2; }
  if (toSide === 'left') { x2 = toP.x; y2 = toP.y + toH / 2; }
  else if (toSide === 'top') { x2 = toP.cx; y2 = toP.y; }
  else if (toSide === 'bottom') { x2 = toP.cx; y2 = toP.y + toH; }
  else if (toSide === 'right') { x2 = toP.x + toNode.width; y2 = toP.y + toH / 2; }
  else { x2 = toP.x; y2 = toP.y + toH / 2; }
  const dx = x2 - x1;
  const dy = y2 - y1;
  const midX = x1 + dx / 2;
  if (Math.abs(dy) < 5) {
    // Same row: smooth bezier curve
    return 'M ' + x1 + ' ' + y1 + ' C ' + (x1 + 60) + ' ' + y1 + ', ' + (x2 - 60) + ' ' + y2 + ', ' + x2 + ' ' + y2;
  } else if (fromSide === 'bottom' || toSide === 'top') {
    // Vertical connection: smooth S-curve
    var midY = (y1 + y2) / 2;
    return 'M ' + x1 + ' ' + y1 + ' C ' + x1 + ' ' + (y1 + 40) + ', ' + x2 + ' ' + (midY - 20) + ', ' + x2 + ' ' + midY + ' S ' + x2 + ' ' + (y2 - 40) + ', ' + x2 + ' ' + y2;
  } else {
    // Cross-lane: bezier through midpoint
    if (Math.abs(dx) > 60) {
      return 'M ' + x1 + ' ' + y1 + ' C ' + (x1 + 40) + ' ' + y1 + ', ' + (midX - 20) + ' ' + y1 + ', ' + midX + ' ' + ((y1 + y2) / 2) + ' S ' + (midX + 20) + ' ' + y2 + ', ' + (x2 - 40) + ' ' + y2 + ' S ' + x2 + ' ' + y2 + ', ' + x2 + ' ' + y2;
    } else {
      return 'M ' + x1 + ' ' + y1 + ' C ' + x1 + ' ' + (y1 + 40) + ', ' + x2 + ' ' + (y1 + 40) + ', ' + x2 + ' ' + y2;
    }
  }
}

function fcGetNodeDetail(nodeId) {
  const details = {
    'bank-entry': { desc: '完成上月月末银行回单录入。根据出纳提供的银行回单逐笔制单。无法区分对应项目的催项目核实确认。未开票的回单催项目补开票申请和应收单。', schedule: '每月1号', priority: '高' },
    'billing': { desc: '根据项目开票申请和用友财务软件中的应收单，每日下午3点统一开票。开票后同步制单，确保当日事当日毕。查看用友当月营业额统计表，涉及跨期营业额的当日发给项目。', schedule: '每日下午3点', priority: '高' },
    'receipt-plan': { desc: '制单顺序铁律：先做收款计划单据，后做应收单单据。给非高校客户开具的餐费发票，收款计划应据实填写6%税率。', schedule: '2号开始', priority: '高' },
    'receivable': { desc: '后做应收单据。开具以前月份收入的发票，做应收单，冲销以前收款计划。避免收入重复：开票前与项目确认该笔费用是否做到了上月的收款计划。', schedule: '2-3号', priority: '高' },
    'daily-billing': { desc: '日常开票制单、银行回单处理。每日下午3点统一开票制单。此为每日工作要点：项目回复和补开票较慢，需提前催。', schedule: '11-25号', priority: '中' },
    'revenue-stats': { desc: '完成科桥餐饮项目营业额统计分析表（当月数+累计）。报成本核算科和管理一科。按差额（自营收入/网点收入/合计）+全额分类。', schedule: '3号前', priority: '高' },
    'compare-stats': { desc: '完成科桥餐饮项目同期营业额统计分析表（当月+累计+2025年对比）。含自营收入/网点收入/合计/代收代扣/差额/增减列。报管理一科。', schedule: '3号前', priority: '高' },
    'exception-summary': { desc: '完成餐饮公司经营情况异常问题分类分工汇总定稿。根据同期对比表中的增减数据，为各项目填写异常情况说明。', schedule: '4号', priority: '高' },
    'ar-aging': { desc: '完成三个应收账款统计表（科桥餐饮公司、利得行、科桥空调）。5档逾期（1月/2-3月/3-6月/6-12月/12月以上）。复核科桥汽车服务、东吴建筑与科目余额表核对。', schedule: '4号', priority: '高' },
    'six-reports': { desc: '每月3号前提交7份最终月度报表。复核人：谢苗苗。1.科桥餐饮公司各项指标明细（按营业额计算各成本费用）2.科桥餐饮项目营业额统计分析表 3.科桥餐饮项目同期营业额统计分析表 4.利得行应收账款统计表 5.科桥餐饮公司应收账款统计表 6.科桥空调应收账款统计表 7.餐饮公司经营情况异常问题分类分工汇总', schedule: '3号截止', priority: '高' },
    'personal-tax': { desc: '先申报个税。7家公司（原8家，芜湖已注销）：铜仁(季报)、贵州(月报)、济南(月报)、新疆(月报)、福州(季报)、厦门(月报)。', schedule: '9号开始', priority: '高' },
    'company-tax': { desc: '7家公司税务申报（增值税+附加+所得税）。截止10号前完成。申报完成后同步填写附件中两张表和税金缴纳确认表。', schedule: '10号截止', priority: '高' },
    'statistics': { desc: '3家餐饮公司统计报表报送（5号前）+2家东吴服务公司税金预估报送（5号前）。兰州博习/甘肃科桥/兰州莘源统计申报（统计云+电子台账，工资数据由人资提供）。', schedule: '5号截止', priority: '高' },
    'output-tax-check': { desc: '核对销项税额与开票系统税额一致。核对顺序：先核对销项税额，后核对收入。', schedule: '30号', priority: '高' },
    'gl-revenue-check': { desc: '核对总账收入（主营业务收入/餐饮收入+商品销售收入+其他服务收入）与开票系统收入一致。先核对销项税额，后核对收入。', schedule: '30号', priority: '高' },
    'zakou': { desc: '19家扎口核算公司：银行对账、利息入账、销项税核对、扎口平账。月末统一完成。', schedule: '30号', priority: '高' }
  };
  return details[nodeId] || { desc: '暂无详情', schedule: '-', priority: '-' };
}

function fcRenderDiagram() {
  const wrap = document.getElementById('fcSvgWrap');
  if (!wrap) return;
  const editor = document.getElementById('fcJsonEditor');
  if (editor && editor.value.trim()) {
    try { fcIR = JSON.parse(editor.value); } catch(e) { showToast('JSON 格式错误，使用上次数据'); }
  }
  const layout = fcCalcLayout(fcIR);
  const dark = fcDarkMode;
  const bgColor = dark ? '#1e293b' : '#f8fafc';
  const laneBg = dark ? '#334155' : '#f1f5f9';
  const laneAltBg = dark ? '#1e293b' : '#ffffff';
  const textColor = dark ? '#e2e8f0' : '#1e293b';
  const mutedColor = dark ? '#94a3b8' : '#64748b';
  const borderColor = dark ? '#475569' : '#e2e8f0';
  const phaseColor = dark ? '#60a5fa' : '#1d4ed8';

  let svg = '<svg xmlns="http://www.w3.org/2000/svg" width="' + layout.svgWidth + '" height="' + layout.svgHeight + '" viewBox="0 0 ' + layout.svgWidth + ' ' + layout.svgHeight + '" style="transform:scale(' + fcZoomLevel + ') translate(' + fcPanX + 'px,' + fcPanY + 'px);transform-origin:center" id="fcSvg">';
  svg += '<rect width="' + layout.svgWidth + '" height="' + layout.svgHeight + '" fill="' + bgColor + '"/>';
  // Arrow markers
  var variants = ['default','emphasis','dashed','security'];
  for (var vi = 0; vi < variants.length; vi++) {
    var v = variants[vi];
    var mc = v === 'security' ? '#ef4444' : v === 'emphasis' ? (dark ? '#60a5fa' : '#2563eb') : v === 'dashed' ? (dark ? '#64748b' : '#94a3b8') : (dark ? '#94a3b8' : '#64748b');
    svg += '<defs><marker id="fcArrow-' + v + '" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto"><path d="M0,0 L8,3 L0,6 Z" fill="' + mc + '"/></marker></defs>';
  }
  // Phase headers
  fcIR.phases.forEach(function(phase) {
    var x1 = FC_LEFT_MARGIN + phase.fromCol * FC_COL_WIDTH;
    var x2 = FC_LEFT_MARGIN + (phase.toCol + 1) * FC_COL_WIDTH;
    var w = x2 - x1;
    var isEmphasis = phase.variant === 'emphasis';
    var phaseBg = isEmphasis ? (dark ? 'rgba(96,165,250,0.15)' : 'rgba(37,99,235,0.08)') : (dark ? 'rgba(100,116,139,0.1)' : 'rgba(100,116,139,0.05)');
    svg += '<rect x="' + x1 + '" y="10" width="' + w + '" height="35" fill="' + phaseBg + '" rx="6" stroke="' + (isEmphasis ? phaseColor : borderColor) + '" stroke-width="1"' + (phase.variant === 'dashed' ? ' stroke-dasharray="4,2"' : '') + '/>';
    svg += '<text x="' + (x1 + w/2) + '" y="32" text-anchor="middle" class="fc-phase-label" fill="' + phaseColor + '">' + phase.label + '</text>';
  });
  // Lanes
  fcIR.lanes.forEach(function(lane, i) {
    var y = FC_TOP_MARGIN + i * (FC_LANE_HEIGHT + FC_LANE_GAP);
    var bg = i % 2 === 0 ? laneBg : laneAltBg;
    svg += '<rect x="' + (FC_LEFT_MARGIN - 10) + '" y="' + y + '" width="' + (layout.svgWidth - FC_LEFT_MARGIN * 2 + 20) + '" height="' + FC_LANE_HEIGHT + '" fill="' + bg + '" rx="8" stroke="' + borderColor + '" stroke-width="1"/>';
    svg += '<rect x="' + (FC_LEFT_MARGIN - 10) + '" y="' + y + '" width="4" height="' + FC_LANE_HEIGHT + '" fill="' + fcGetTypeColor('backend').stroke + '" rx="2"/>';
    svg += '<text x="' + FC_LEFT_MARGIN + '" y="' + (y + 20) + '" class="fc-lane-label" fill="' + textColor + '">' + lane.label + '</text>';
  });
  // Animated edges (flowing dashed for emphasis, particles for all)
  fcIR.edges.forEach(function(edge) {
    var path = fcBuildEdgePath(edge, fcIR);
    if (!path) return;
    var strokeColor = edge.variant === 'security' ? '#ef4444' : edge.variant === 'emphasis' ? (dark ? '#60a5fa' : '#2563eb') : edge.variant === 'dashed' ? (dark ? '#64748b' : '#94a3b8') : (dark ? '#94a3b8' : '#64748b');
    var dashArray = edge.variant === 'dashed' ? '5,3' : '';
    // Main path line
    svg += '<path d="' + path + '" class="fc-edge' + (edge.variant === 'emphasis' ? ' fc-flow-emphasis' : '') + '" data-edge-id="' + edge.id + '" data-from="' + edge.from + '" data-to="' + edge.to + '" stroke="' + strokeColor + '" stroke-width="1.5" fill="none" stroke-dasharray="' + dashArray + '" marker-end="url(#fcArrow-' + (edge.variant || 'default') + ')"/>';
    // Animated glow path (behind) for emphasis edges
    if (edge.variant === 'emphasis') {
      svg += '<path d="' + path + '" class="fc-edge-glow" data-glow-for="' + edge.id + '" stroke="' + strokeColor + '" stroke-width="4" fill="none" opacity="0.12" stroke-linecap="round"/>';
    }
    // Edge label
    if (edge.label) {
      var fromN = fcIR.nodes.find(function(n){return n.id === edge.from;});
      var toN = fcIR.nodes.find(function(n){return n.id === edge.to;});
      if (fromN && toN) {
        var fp = fcNodePos(fromN, fcIR);
        var tp = fcNodePos(toN, fcIR);
        var lx = (fp.cx + tp.cx) / 2;
        var ly = (fp.cy + tp.cy) / 2 - 4;
        svg += '<text x="' + lx + '" y="' + ly + '" text-anchor="middle" class="fc-edge-label" fill="' + mutedColor + '">' + edge.label + '</text>';
      }
    }
  });
  // Nodes
  fcIR.nodes.forEach(function(node) {
    var pos = fcNodePos(node, fcIR);
    var h = node.tag ? FC_NODE_TAG_HEIGHT : FC_NODE_HEIGHT;
    var colors = fcGetTypeColor(node.type);
    svg += '<g class="fc-node" data-node-id="' + node.id + '" onclick="fcSelectNode(\'' + node.id + '\')">';
    svg += '<rect class="fc-node-box" x="' + pos.x + '" y="' + pos.y + '" width="' + node.width + '" height="' + h + '" fill="' + colors.fill + '" stroke="' + colors.stroke + '" stroke-width="1.5" rx="8"/>';
    svg += '<text x="' + (pos.x + node.width/2) + '" y="' + (pos.y + 18) + '" text-anchor="middle" class="fc-node-title" fill="' + textColor + '">' + node.label + '</text>';
    if (node.sublabel) {
      svg += '<text x="' + (pos.x + node.width/2) + '" y="' + (pos.y + 34) + '" text-anchor="middle" class="fc-node-sub" fill="' + mutedColor + '">' + node.sublabel + '</text>';
    }
    if (node.tag) {
      var tagColor = node.tag.indexOf('截止') >= 0 ? '#ef4444' : node.tag.indexOf('号') >= 0 ? '#f59e0b' : '#0d9488';
      var tagBg = node.tag.indexOf('截止') >= 0 ? (dark ? '#7f1d1d' : '#fee2e2') : node.tag.indexOf('号') >= 0 ? (dark ? '#78350f' : '#fef3c7') : (dark ? '#134e4a' : '#ccfbf1');
      svg += '<rect x="' + (pos.x + node.width/2 - 22) + '" y="' + (pos.y + h - 16) + '" width="44" height="14" rx="3" fill="' + tagBg + '"/>';
      svg += '<text x="' + (pos.x + node.width/2) + '" y="' + (pos.y + h - 5) + '" text-anchor="middle" class="fc-node-tag" fill="' + tagColor + '">' + node.tag + '</text>';
    }
    svg += '</g>';
  });
  svg += '</svg>';
  wrap.innerHTML = svg;
  wrap.className = 'fc-svg-wrap' + (dark ? ' dark' : '');
  fcRenderLegend();
  fcApplyView(fcCurrentView);
}

function fcRenderLegend() {
  var container = document.getElementById('fcLegend');
  if (!container) return;
  var types = [];
  fcIR.nodes.forEach(function(n) { if (types.indexOf(n.type) < 0) types.push(n.type); });
  container.innerHTML = types.map(function(t) {
    var c = fcGetTypeColor(t);
    return '<div class="fc-legend-item"><div class="fc-legend-dot" style="background:' + c.fill + ';border:1px solid ' + c.stroke + '"></div>' + c.label + '</div>';
  }).join('');
}

function fcSelectNode(nodeId) {
  fcSelectedNode = nodeId;
  var node = fcIR.nodes.find(function(n){return n.id === nodeId;});
  if (!node) return;
  var detail = fcGetNodeDetail(nodeId);
  var colors = fcGetTypeColor(node.type);
  var panel = document.getElementById('fcInfoPanel');
  if (!panel) return;
  var priColor = detail.priority === '高' ? 'var(--red)' : detail.priority === '中' ? '#92400e' : 'var(--muted)';
  var priBg = detail.priority === '高' ? 'var(--red-l)' : detail.priority === '中' ? 'var(--amber-l)' : 'var(--slate-l)';
  panel.innerHTML = '<div class="fc-info-title">' + node.label + ' <span class="fc-info-tag" style="background:' + colors.fill + ';color:' + colors.stroke + '">' + (node.sublabel || '') + '</span></div><div class="fc-info-body"><div style="margin-bottom:6px">' + detail.desc + '</div><div style="display:flex;gap:12px;font-size:11px"><span><strong>时间：</strong>' + detail.schedule + '</span><span class="fc-stat-badge" style="background:' + priBg + ';color:' + priColor + '">优先级：' + detail.priority + '</span></div></div>';
  document.querySelectorAll('.fc-edge').forEach(function(e) {
    var from = e.getAttribute('data-from');
    var to = e.getAttribute('data-to');
    if (from === nodeId || to === nodeId) { e.classList.add('highlight'); e.classList.remove('dim'); }
    else { e.classList.add('dim'); e.classList.remove('highlight'); }
  });
  document.querySelectorAll('.fc-node').forEach(function(n) {
    var id = n.getAttribute('data-node-id');
    var connected = fcIR.edges.some(function(e){return (e.from === nodeId && e.to === id) || (e.to === nodeId && e.from === id);});
    if (id === nodeId || connected) { n.classList.remove('dim'); }
    else { n.classList.add('dim'); }
  });
}

function fcClearHighlight() {
  document.querySelectorAll('.fc-edge').forEach(function(e){e.classList.remove('dim','highlight');});
  document.querySelectorAll('.fc-node').forEach(function(n){n.classList.remove('dim');});
}

function fcSetView(view) {
  fcCurrentView = view;
  document.querySelectorAll('.fc-toolbar .fc-btn').forEach(function(b){b.classList.remove('active');});
  var btn = document.getElementById('fcView' + view.charAt(0).toUpperCase() + view.slice(1));
  if (btn) btn.classList.add('active');
  fcApplyView(view);
  if (view === 'full') fcClearHighlight();
}

function fcApplyView(view) {
  if (view === 'full') return;
  var views = {
    report: ['bank-entry','receipt-plan','receivable','billing','revenue-stats','compare-stats','exception-summary','ar-aging','six-reports'],
    tax: ['personal-tax','company-tax','statistics'],
    reconcile: ['output-tax-check','gl-revenue-check','zakou','daily-billing']
  };
  var focus = views[view];
  if (!focus) return;
  document.querySelectorAll('.fc-node').forEach(function(n) {
    var id = n.getAttribute('data-node-id');
    n.classList.toggle('dim', focus.indexOf(id) < 0);
  });
  document.querySelectorAll('.fc-edge').forEach(function(e) {
    var from = e.getAttribute('data-from');
    var to = e.getAttribute('data-to');
    var inView = focus.indexOf(from) >= 0 && focus.indexOf(to) >= 0;
    e.classList.toggle('dim', !inView);
  });
}

function fcZoom(delta) {
  fcZoomLevel = Math.max(0.3, Math.min(2.5, fcZoomLevel + delta));
  fcRenderDiagram();
}

function fcZoomReset() {
  fcZoomLevel = 1; fcPanX = 0; fcPanY = 0;
  fcRenderDiagram();
}

function fcToggleTheme() {
  fcDarkMode = !fcDarkMode;
  var btn = document.getElementById('fcThemeBtn');
  if (btn) btn.textContent = fcDarkMode ? '浅色主题' : '深色主题';
  fcRenderDiagram();
}

var fcFlowActive = false;
function fcToggleFlow() {
  fcFlowActive = !fcFlowActive;
  var wrap = document.getElementById('fcSvgWrap');
  var btn = document.getElementById('fcFlowBtn');
  if (!wrap) return;
  if (fcFlowActive) {
    wrap.classList.add('fc-flow-anim');
    wrap.classList.remove('fc-flow-paused');
    if (btn) { btn.textContent = '暂停流动'; btn.classList.add('active'); }
  } else {
    wrap.classList.remove('fc-flow-anim');
    wrap.classList.add('fc-flow-paused');
    if (btn) { btn.textContent = '动态流动'; btn.classList.remove('active'); }
  }
}

function fcExportPNG() {
  var svgEl = document.getElementById('fcSvg');
  if (!svgEl) { showToast('请先渲染流程图'); return; }
  var serializer = new XMLSerializer();
  var svgStr = serializer.serializeToString(svgEl);
  var blob = new Blob([svgStr], { type: 'image/svg+xml' });
  var url = URL.createObjectURL(blob);
  var img = new Image();
  img.onload = function() {
    var layout = fcCalcLayout(fcIR);
    var canvas = document.createElement('canvas');
    canvas.width = layout.svgWidth * 2;
    canvas.height = layout.svgHeight * 2;
    var ctx = canvas.getContext('2d');
    ctx.fillStyle = fcDarkMode ? '#1e293b' : '#ffffff';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
    canvas.toBlob(function(blob) {
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = '月度工作流程图_' + (new Date().getMonth() + 1) + '月.png';
      a.click();
      URL.revokeObjectURL(a.href);
    });
    URL.revokeObjectURL(url);
    showToast('PNG 已导出');
  };
  img.onerror = function() { showToast('导出失败，请重试'); URL.revokeObjectURL(url); };
  img.src = url;
}

function fcExportJSON() {
  var json = JSON.stringify(fcIR, null, 2);
  var blob = new Blob([json], { type: 'application/json' });
  var a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = '月度工作流程图_IR.json';
  a.click();
  URL.revokeObjectURL(a.href);
  showToast('JSON IR 已导出');
}

function fcResetData() {
  fcIR = JSON.parse(JSON.stringify(FC_DEFAULT_IR));
  var editor = document.getElementById('fcJsonEditor');
  if (editor) editor.value = JSON.stringify(fcIR, null, 2);
  fcRenderDiagram();
  showToast('数据已恢复默认');
}

// ==================== Play Story System ====================
var fcStoryTimer = null;
var fcStoryStep = 0;
var fcStorySteps = [];

function fcBuildStorySteps() {
  var visited = new Set();
  var steps = [];
  var incoming = {};
  fcIR.edges.forEach(function(e) {
    if (!incoming[e.to]) incoming[e.to] = [];
    incoming[e.to].push(e.from);
  });
  var starts = fcIR.nodes.filter(function(n) { return !incoming[n.id]; });
  starts.forEach(function(node) {
    steps.push({ type: 'node', id: node.id, label: node.label, detail: fcGetNodeDetail(node.id) });
    visited.add(node.id);
  });
  var queue = starts.map(function(n){return n.id;});
  var qi = 0;
  while (qi < queue.length) {
    var current = queue[qi++];
    var outgoing = fcIR.edges.filter(function(e){return e.from === current;});
    outgoing.forEach(function(edge) {
      var to = edge.to;
      if (visited.has(to)) return;
      visited.add(to);
      var fromNode = fcIR.nodes.find(function(n){return n.id === edge.from;});
      var toNode = fcIR.nodes.find(function(n){return n.id === to;});
      steps.push({ type: 'edge', from: edge.from, to: to, label: edge.label, fromLabel: fromNode ? fromNode.label : '', toLabel: toNode ? toNode.label : '' });
      steps.push({ type: 'node', id: to, label: toNode ? toNode.label : '', detail: fcGetNodeDetail(to) });
      queue.push(to);
    });
  }
  return steps;
}

function fcPlayStory() {
  var btn = document.getElementById('fcPlayBtn');
  if (fcStoryTimer) {
    clearTimeout(fcStoryTimer);
    fcStoryTimer = null;
    if (btn) {
      btn.classList.remove('active');
      btn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M8 5v14l11-7z"/></svg><span id="fcPlayLabel">演示故事</span>';
    }
    var wrap = document.getElementById('fcSvgWrap');
    if (wrap) wrap.classList.remove('fc-story-active');
    return;
  }
  fcSetView('full');
  fcStorySteps = fcBuildStorySteps();
  fcStoryStep = 0;
  if (btn) {
    btn.classList.add('active');
    btn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg><span id="fcPlayLabel">暂停演示</span>';
  }
  var wrap = document.getElementById('fcSvgWrap');
  if (wrap) wrap.classList.add('fc-story-active');
  fcStoryNext();
}

function fcStoryNext() {
  if (fcStoryStep >= fcStorySteps.length) {
    fcCancelStory();
    showToast('演示完成');
    return;
  }
  var step = fcStorySteps[fcStoryStep];
  document.querySelectorAll('.fc-node').forEach(function(n){n.classList.remove('glow');});
  document.querySelectorAll('.fc-edge').forEach(function(e){e.classList.remove('highlight');});
  
  if (step.type === 'node') {
    var nodeEl = document.querySelector('.fc-node[data-node-id="' + step.id + '"]');
    if (nodeEl) {
      nodeEl.classList.add('glow');
      nodeEl.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
    }
    var panel = document.getElementById('fcInfoPanel');
    var node = fcIR.nodes.find(function(n){return n.id === step.id;});
    if (panel && node) {
      var detail = step.detail;
      var colors = fcGetTypeColor(node.type);
      var priColor = detail.priority === '高' ? 'var(--red)' : detail.priority === '中' ? '#92400e' : 'var(--muted)';
      var priBg = detail.priority === '高' ? 'var(--red-l)' : detail.priority === '中' ? 'var(--amber-l)' : 'var(--slate-l)';
      panel.innerHTML = '<div class="fc-info-title">' + node.label + ' <span class="fc-info-tag" style="background:' + colors.fill + ';color:' + colors.stroke + '">' + (node.sublabel || '') + '</span></div><div class="fc-info-body"><div style="margin-bottom:6px">' + detail.desc + '</div><div style="display:flex;gap:12px;font-size:11px"><span><strong>' + (fcStoryStep + 1) + '/' + fcStorySteps.length + ' 时间：</strong>' + detail.schedule + '</span><span class="fc-stat-badge" style="background:' + priBg + ';color:' + priColor + '">优先级：' + detail.priority + '</span></div></div>';
    }
    fcStoryTimer = setTimeout(fcStoryNext, 2500);
  } else {
    var edgeEl = document.querySelector('.fc-edge[data-from="' + step.from + '"][data-to="' + step.to + '"]');
    if (edgeEl) edgeEl.classList.add('highlight');
    fcStoryTimer = setTimeout(fcStoryNext, 1500);
  }
  fcStoryStep++;
}

function fcCancelStory() {
  if (fcStoryTimer) { clearTimeout(fcStoryTimer); fcStoryTimer = null; }
  document.querySelectorAll('.fc-node').forEach(function(n){n.classList.remove('glow');});
  document.querySelectorAll('.fc-edge').forEach(function(e){e.classList.remove('highlight');});
  var wrap = document.getElementById('fcSvgWrap');
  if (wrap) wrap.classList.remove('fc-story-active');
  var btn = document.getElementById('fcPlayBtn');
  if (btn) {
    btn.classList.remove('active');
    btn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M8 5v14l11-7z"/></svg><span id="fcPlayLabel">演示故事</span>';
  }
}

function fcInitEditor() {
  var editor = document.getElementById('fcJsonEditor');
  if (editor) editor.value = JSON.stringify(fcIR, null, 2);
}

// ==================== Monthly Review ====================
var FC_REVIEW_KEY = 'haoge_fc_review';

function fcGetReviewMonths() {
  var now = new Date();
  var months = [];
  for (var i = 0; i < 12; i++) {
    var d = new Date(now.getFullYear(), now.getMonth() - i, 1);
    months.push(d.getFullYear() + '-' + (d.getMonth() + 1 < 10 ? '0' : '') + (d.getMonth() + 1));
  }
  return months;
}

function fcInitReviewMonth() {
  var sel = document.getElementById('fcReviewMonth');
  if (!sel) return;
  var months = fcGetReviewMonths();
  sel.innerHTML = months.map(function(m) {
    return '<option value="' + m + '">' + m.slice(0,4) + '年' + parseInt(m.slice(5)) + '月</option>';
  }).join('');
  var now = new Date();
  var current = now.getFullYear() + '-' + (now.getMonth() + 1 < 10 ? '0' : '') + (now.getMonth() + 1);
  sel.value = current;
}

function fcLoadReview() {
  var sel = document.getElementById('fcReviewMonth');
  if (!sel) return;
  var month = sel.value;
  var all = fcLoadAllReviews();
  var data = all[month] || { done: '', issues: '', improve: '', lessons: '' };
  document.getElementById('rvDone').value = data.done || '';
  document.getElementById('rvIssues').value = data.issues || '';
  document.getElementById('rvImprove').value = data.improve || '';
  document.getElementById('rvLessons').value = data.lessons || '';
  fcUpdateStats(month, all);
  fcRenderTrend(all);
}

function fcLoadAllReviews() {
  try {
    var raw = localStorage.getItem(FC_REVIEW_KEY);
    return raw ? JSON.parse(raw) : {};
  } catch(e) { return {}; }
}

function fcSaveReview() {
  var sel = document.getElementById('fcReviewMonth');
  if (!sel) return;
  var month = sel.value;
  var all = fcLoadAllReviews();
  all[month] = {
    done: document.getElementById('rvDone').value,
    issues: document.getElementById('rvIssues').value,
    improve: document.getElementById('rvImprove').value,
    lessons: document.getElementById('rvLessons').value,
    ts: Date.now()
  };
  try {
    localStorage.setItem(FC_REVIEW_KEY, JSON.stringify(all));
    showToast('复盘已保存');
    fcUpdateStats(month, all);
    fcRenderTrend(all);
  } catch(e) { showToast('保存失败'); }
}

function fcClearReview() {
  var sel = document.getElementById('fcReviewMonth');
  if (!sel) return;
  var month = sel.value;
  var all = fcLoadAllReviews();
  delete all[month];
  try {
    localStorage.setItem(FC_REVIEW_KEY, JSON.stringify(all));
    document.getElementById('rvDone').value = '';
    document.getElementById('rvIssues').value = '';
    document.getElementById('rvImprove').value = '';
    document.getElementById('rvLessons').value = '';
    showToast('已清空');
    fcUpdateStats(month, all);
    fcRenderTrend(all);
  } catch(e) {}
}

function fcCopyReview() {
  var sel = document.getElementById('fcReviewMonth');
  if (!sel) return;
  var month = sel.value;
  var done = document.getElementById('rvDone').value;
  var issues = document.getElementById('rvIssues').value;
  var improve = document.getElementById('rvImprove').value;
  var lessons = document.getElementById('rvLessons').value;
  var text = '=== ' + month + ' 月度工作复盘 ===\n\n【完成情况】\n' + done + '\n\n【异常与问题】\n' + issues + '\n\n【改进措施】\n' + improve + '\n\n【经验总结】\n' + lessons;
  if (navigator.clipboard) {
    navigator.clipboard.writeText(text).then(function(){showToast('复盘文本已复制');}).catch(function(){
      var ta = document.createElement('textarea');
      ta.value = text; document.body.appendChild(ta); ta.select();
      document.execCommand('copy'); document.body.removeChild(ta);
      showToast('复盘文本已复制');
    });
  } else {
    var ta = document.createElement('textarea');
    ta.value = text; document.body.appendChild(ta); ta.select();
    document.execCommand('copy'); document.body.removeChild(ta);
    showToast('复盘文本已复制');
  }
}

function fcUpdateStats(month, all) {
  var data = all[month];
  var el = document.getElementById('rvStats');
  if (!el) return;
  if (!data || (!data.done && !data.issues && !data.improve && !data.lessons)) {
    el.innerHTML = '本月暂无复盘记录';
    return;
  }
  var total = (data.done||'').length + (data.issues||'').length + (data.improve||'').length + (data.lessons||'').length;
  var ts = data.ts ? new Date(data.ts).toLocaleString('zh-CN') : '未知';
  el.innerHTML = '共 ' + total + ' 字 | 最后保存：' + ts;
}

function fcRenderTrend(all) {
  var container = document.getElementById('rvTrend');
  if (!container) return;
  var months = fcGetReviewMonths().slice(0, 6).reverse();
  var maxLen = 1;
  months.forEach(function(m) {
    var d = all[m];
    if (d) {
      var len = (d.done||'').length + (d.issues||'').length + (d.improve||'').length + (d.lessons||'').length;
      if (len > maxLen) maxLen = len;
    }
  });
  container.innerHTML = months.map(function(m) {
    var d = all[m];
    var len = d ? (d.done||'').length + (d.issues||'').length + (d.improve||'').length + (d.lessons||'').length : 0;
    var h = Math.max(4, (len / maxLen) * 80);
    var hasData = len > 0;
    return '<div style="text-align:center;cursor:pointer;flex:1;min-width:60px" onclick="document.getElementById(\'fcReviewMonth\').value=\'' + m + '\';fcLoadReview()"><div style="height:' + h + 'px;background:' + (hasData ? 'var(--pri)' : 'var(--border)') + ';border-radius:4px 4px 0 0;transition:.3s;margin-bottom:4px"></div><div style="font-size:10px;color:var(--muted)">' + m.slice(5) + '月</div>' + (hasData ? '<div style="font-size:9px;color:var(--pri)">' + len + '字</div>' : '') + '</div>';
  }).join('');
}

function fcInit() {
  fcInitEditor();
  fcInitReviewMonth();
  fcRenderDiagram();
  fcLoadReview();
  var wrap = document.getElementById('fcSvgWrap');
  if (wrap) wrap.classList.add('fc-flow-paused');
  var fullBtn = document.getElementById('fcViewFull');
  if (fullBtn) fullBtn.classList.add('active');
}

// ==================== Init ====================
loadData();
updateDateDisplay();
renderTodayTasks();
renderDynamicAlerts();
renderTimeline();
renderCycleTable();
renderNotices();
renderTaxGrid();
renderReportCards();
renderDataRows();
autoCalc();
renderProjects('all');
renderZakouGrid();
renderTaxDiff();
renderUnresolved();
fcInit();
// Restore stat filing state
for(let i=1;i<=3;i++){
  if(state.tasks['stat_'+i]){
    const el = document.getElementById('stat'+i);
    if(el){ el.classList.add('done'); el.querySelector('.tx-status').textContent = '✓ 已申报'; }
  }
}
setInterval(updateDateDisplay, 60000);
</script>
</body>
</html>