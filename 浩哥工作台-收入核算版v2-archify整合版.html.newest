const ZAKOU_COMPANIES = [
  '苏州科桥空调设备工程有限公司','苏州工业园区科桥餐饮服务有限公司','科桥餐饮兰州分公司','科桥餐饮广东分公司','科桥餐饮上海分公司','贵州科桥餐饮管理服务有限公司','科桥餐饮台账','贵州科桥台账','苏州中鸿源服务外包有限公司','南通博习餐饮管理有限公司','苏州利得行保安服务有限公司','利得行管理咨询(上海)有限公司','利得行管理咨询(上海)苏州分公司','苏州利得行建筑咨询事务所','兰州博习餐饮管理有限公司','甘肃科桥餐饮管理有限公司','兰州莘源餐饮管理有限公司','兰州恒新餐饮管理有限公司','淮安科桥餐饮管理有限公司'
];

function renderZakouGrid(){
  const container = document.getElementById('zakouGrid');
  if(!container) return;
  container.innerHTML = '';
  ZAKOU_COMPANIES.forEach((name, i) => {
    const key = 'zakou_' + i;
    if(!state.tasks[key]) state.tasks[key] = false;
    const done = state.tasks[key];
    const div = document.createElement('div');
    div.className = 'tax-item' + (done ? ' done' : '');
    div.onclick = () => {
      state.tasks[key] = !state.tasks[key];
      saveData();
      renderZakouGrid();
    };
    const shortName = name.replace('苏州工业园区','').replace('有限公司','').replace('管理有限公司','');
    div.innerHTML = `
      <div class="tx-name" style="font-size:12px">${shortName}</div>
      <div class="tx-status">${done ? '✓ 已完成' : '银行对账/利息/销项税/平账'}</div>
    `;
    container.appendChild(div);
  });
}

