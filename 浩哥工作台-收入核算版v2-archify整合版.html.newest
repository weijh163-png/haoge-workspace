      <td style="padding:6px 8px">${d.name}</td>
      <td style="padding:6px 8px;text-align:right">${fmt(d.balance)}</td>
      <td style="padding:6px 8px;text-align:right">${fmt(d.actual)}</td>
      <td style="padding:6px 8px;text-align:right;font-weight:700;color:${diffColor}">${d.diff<0?'-':''}${fmt(d.diff)}</td>
      <td style="padding:6px 8px;font-size:11px">${d.note}</td>
    `;
    tbody.appendChild(tr);
  });
}

